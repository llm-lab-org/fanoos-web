.mx_QuickSettingsButton {
    border-radius: 8px !important;
    margin: 12px auto 12px;

    svg {
        fill: $secondary-content;
    }

    &:not(.expanded):hover {
        background-color: $quaternary-content !important;
        color: $primary-content;
        svg {
            fill: $primary-content;
        }
    }

    &.expanded {
        background-color: transparent !important;
        margin-left: 21px;
        margin-right: 8px;
        width: 100%;

        & > div {
            display: flex;
            align-items: center;
        }

        svg {
            margin-right: 14px;
            width: 24px;
            flex-shrink: 0;
        }

        & .mx_QuickSettingsButton_label {
            color: $secondary-content !important;
        }
    }
}

/* ══════════════════════════════════════════
   Context menu panel
══════════════════════════════════════════ */
.mx_QuickSettingsButton_ContextMenuWrapper .mx_ContextualMenu {
    padding: 0;
    width: max-content;
    width: 360px;
    contain: unset;
    border-radius: 16px;
    box-shadow:
        0 0 0 1px var(--cpd-color-border-disabled),
        0 12px 32px rgb(0 0 0 / 18%),
        0 4px 10px rgb(0 0 0 / 10%);
    overflow: hidden;

    /* Scrollable inner div */
    > div {
        padding: 0;
        max-height: 90vh;
        overflow-y: auto;
        scrollbar-width: thin;
        text-align: center;
    }

    /* ── Header bar ── */
    > div > h2 {
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-14px;
        line-height: 1;
        color: var(--cpd-color-text-secondary);
        margin: 0;
        padding: 14px 20px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        background: var(--cpd-color-bg-subtle-primary);
        border-bottom: 1px solid var(--cpd-color-border-disabled);
    }

    /* ── All Settings / Devtools buttons ── */
    .mx_AccessibleButton_hasKind {
        display: block;
        margin: 0 20px 0;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: $font-14px;
        font-weight: 500;
        text-align: center;

        &:first-of-type {
            margin-top: 16px;
        }
        & + .mx_AccessibleButton_hasKind {
            margin-top: 8px;
        }
    }

    /* ── Native h4 section headings (metaspace) ── */
    > div > h4 {
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-10px;
        line-height: 1;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--cpd-color-text-secondary);
        margin: 20px 20px 10px;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0;
    }

    .mx_QuickSettingsButton_moreOptionsButton {
        margin-left: var(--cpd-space-7x);
        font-size: $font-14px;
        line-height: $font-24px;
        color: var(--cpd-color-text-primary);
        position: relative;
        margin-bottom: 8px;
    }

    .mx_QuickSettingsButton_option {
        margin: 0 20px var(--cpd-space-3x);
        label {
            display: flex;
        }
    }
}

.mx_QuickSettingsButton_ContextMenuWrapper_new_room_list {
    .mx_QuickThemeSwitcher {
        margin-top: var(--cpd-space-2x);
    }
}

.mx_QuickSettingsButton_icon {
    margin-inline-end: var(--cpd-space-1x);
    color: $secondary-content;
    width: 18px;
    height: 18px;
    margin-top: auto;
    margin-bottom: auto;
}

/* ══════════════════════════════════════════
   Fanoos section blocks
══════════════════════════════════════════ */
.mx_QuickSettingsButton_section {
    padding: 14px 16px 16px;
    margin: 0 12px 12px;
    border-radius: 12px;
    background: var(--cpd-color-bg-subtle-secondary);
    border: 1px solid var(--cpd-color-border-disabled);

    &:first-of-type {
        margin-top: 14px;
    }
}

/* ── Section heading ── */
.mx_QuickSettingsButton_sectionHeading {
    font-weight: var(--cpd-font-weight-semibold);
    font-size: $font-10px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cpd-color-text-secondary);
    margin: 14px 20px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;

    &:first-of-type {
        margin-top: 16px;
    }
}

/* ── Pill button row (language / direction) ── */
.mx_QuickSettingsButton_langRow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 7px;
    padding: 0 20px;
    margin-bottom: 4px;
}

.mx_QuickSettingsButton_langButton {
    padding: 7px 16px;
    border-radius: 20px;
    font-size: $font-13px;
    font-weight: 500;
    border: 1.5px solid var(--cpd-color-border-interactive-primary);
    color: var(--cpd-color-text-primary);
    background: var(--cpd-color-bg-canvas-default);
    cursor: pointer;
    transition:
        background 0.15s,
        color 0.15s,
        border-color 0.15s,
        box-shadow 0.12s,
        transform 0.1s;
    line-height: 1.3;

    &:hover {
        background: var(--cpd-color-bg-subtle-primary);
        border-color: var(--cpd-color-bg-action-primary-rest);
        box-shadow: 0 2px 6px rgb(0 0 0 / 10%);
        transform: translateY(-1px);
    }

    &:active {
        transform: translateY(0);
    }

    &.mx_QuickSettingsButton_langButton_active {
        background: var(--cpd-color-bg-action-primary-rest);
        color: var(--cpd-color-text-on-solid-primary);
        border-color: transparent;
        box-shadow: 0 3px 8px rgb(0 0 0 / 20%);
    }
}

/* ══════════════════════════════════════════
   Font size widget
══════════════════════════════════════════ */
.mx_QuickSettingsButton_fontSizeWidget {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 20px 6px;
}

.mx_QuickSettingsButton_fontSizeStep {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--cpd-color-border-interactive-primary);
    background: var(--cpd-color-bg-canvas-default);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--cpd-color-text-primary);
    transition:
        background 0.15s,
        box-shadow 0.12s,
        transform 0.1s;
    font-size: $font-12px;
    padding: 0;
    box-shadow: 0 1px 3px rgb(0 0 0 / 10%);

    &:hover:not([disabled]) {
        background: var(--cpd-color-bg-action-primary-rest);
        color: var(--cpd-color-text-on-solid-primary);
        border-color: transparent;
        box-shadow: 0 3px 8px rgb(0 0 0 / 18%);
        transform: translateY(-1px);
    }

    &:active:not([disabled]) {
        transform: translateY(0);
    }

    &[disabled] {
        opacity: 0.3;
        cursor: default;
        box-shadow: none;
    }
}

.mx_QuickSettingsButton_fontSizeStepBig {
    font-size: $font-18px;
}

.mx_QuickSettingsButton_fontSizeTrack {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--cpd-color-bg-subtle-secondary);
    border: 1px solid var(--cpd-color-border-disabled);
    position: relative;
    overflow: visible;
}

.mx_QuickSettingsButton_fontSizeBar {
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(
        90deg,
        var(--cpd-color-bg-action-primary-rest),
        var(--cpd-color-icon-accent-tertiary, var(--cpd-color-bg-action-primary-rest))
    );
    transition: width 0.2s ease;
    min-width: 6px;

    /* Thumb handle */
    &::after {
        content: "";
        position: absolute;
        right: -5px;
        top: 50%;
        transform: translateY(-50%);
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--cpd-color-bg-action-primary-rest);
        border: 2px solid var(--cpd-color-bg-canvas-default);
        box-shadow: 0 1px 4px rgb(0 0 0 / 20%);
    }
}

.mx_QuickSettingsButton_fontSizeLabel {
    position: absolute;
    top: -24px;
    right: 0;
    font-size: $font-11px;
    font-weight: 600;
    color: var(--cpd-color-text-primary);
    background: var(--cpd-color-bg-canvas-default);
    border: 1px solid var(--cpd-color-border-disabled);
    border-radius: 6px;
    padding: 1px 6px;
    white-space: nowrap;
    box-shadow: 0 1px 3px rgb(0 0 0 / 10%);
}
