/* ── Dashboard Button in SpacePanel ──────────────────────────────── */

.mx_FanoosDashboardButton {
    display: flex;
    align-items: center;
    justify-content: center; /* center icon when collapsed */
    gap: var(--cpd-space-2x);
    width: 100%;
    padding: var(--cpd-space-3x) var(--cpd-space-3x);
    border-radius: 8px;
    cursor: pointer;
    color: $secondary-content;
    background: transparent;
    border: none;
    transition:
        background 0.15s ease,
        color 0.15s ease;
    box-sizing: border-box;

    &:hover {
        background: var(--cpd-color-bg-subtle-primary);
        color: $primary-content;
    }

    &.expanded {
        justify-content: flex-start;
    }

    svg {
        flex-shrink: 0;
        width: 22px;
        height: 22px;
    }
}

.mx_FanoosDashboardButton_label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── Override RoomView wrapper containment when showing Dashboard ─── */

/* contain:strict on mx_RoomView_wrapper would make it the containing block
   for position:fixed children and also clips overflow — override both */
.mx_RoomView_wrapper:has(.mx_FanoosDashboard) {
    contain: none;
    overflow: visible;
}

/* ── Full-page Dashboard Layout ──────────────────────────────────── */

.mx_FanoosDashboard {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #0a1628;
    position: relative;
    color: #e2e8f0;
}

/* ── Top bar ──────────────────────────────────────────────────────── */

.mx_FanoosDashboard_topBar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 16px;
    background: #111827;
    border-bottom: 1px solid rgb(255, 255, 255, 0.06);
    flex-shrink: 0;
    flex-wrap: wrap;
    color: #e2e8f0;
    min-height: 42px;
}

.mx_FanoosDashboard_title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin-right: 6px;
    white-space: nowrap;
}

.mx_FanoosDashboard_ctrlGroup {
    display: flex;
    align-items: center;
    gap: 7px;
}

.mx_FanoosDashboard_ctrlLabel {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgb(148, 163, 184, 0.75);
    white-space: nowrap;
}

.mx_FanoosDashboard_select {
    background: rgb(255, 255, 255, 0.07);
    border: 1px solid rgb(255, 255, 255, 0.12);
    border-radius: 6px;
    color: #e2e8f0;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    outline: none;
    height: 28px;

    &:focus {
        border-color: rgb(99, 102, 241, 0.6);
    }
}

/* ── Ctrl bar ─────────────────────────────────────────────────────── */

.mx_FanoosDashboard_ctrlBar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    background: #0f172a;
    border-bottom: 1px solid rgb(255, 255, 255, 0.05);
    flex-shrink: 0;
    flex-wrap: wrap;
    color: #e2e8f0;
    min-height: 44px;
}

.mx_FanoosDashboard_btnGroup {
    display: flex;
    align-items: center;
    gap: 4px;
}

.mx_FanoosDashboard_divider {
    width: 1px;
    height: 22px;
    background: rgb(255, 255, 255, 0.09);
    flex-shrink: 0;
    margin: 0 2px;
}

.mx_FanoosDashboard_spacer {
    flex: 1;
}

.mx_FanoosDashboard_lvlBtn {
    background: rgb(255, 255, 255, 0.07);
    border: 1px solid rgb(255, 255, 255, 0.11);
    color: rgb(203, 213, 225, 0.8);
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition:
        background 0.15s,
        color 0.15s,
        border-color 0.15s;
    height: 30px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;

    &:hover {
        background: rgb(99, 102, 241, 0.18);
        color: #c7d2fe;
        border-color: rgb(99, 102, 241, 0.4);
    }

    &.active {
        background: rgb(99, 102, 241, 0.28);
        border-color: rgb(129, 140, 248, 0.55);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_searchWrap {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    min-width: 150px;
}

.mx_FanoosDashboard_searchInput {
    flex: 1;
    background: rgb(255, 255, 255, 0.06);
    border: 1px solid rgb(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #e2e8f0;
    padding: 5px 10px;
    font-size: 13px;
    outline: none;
    height: 30px;
    transition: border-color 0.15s;

    &::placeholder {
        color: rgb(148, 163, 184, 0.5);
    }
    &:focus {
        border-color: rgb(129, 140, 248, 0.6);
    }
}

.mx_FanoosDashboard_searchCount {
    font-size: 11px;
    color: rgb(148, 163, 184, 0.7);
    white-space: nowrap;
}

.mx_FanoosDashboard_navBtn {
    background: rgb(255, 255, 255, 0.07);
    border: 1px solid rgb(255, 255, 255, 0.09);
    border-radius: 5px;
    color: #94a3b8;
    padding: 4px 10px;
    font-size: 16px;
    cursor: pointer;
    line-height: 1;
    height: 30px;
    display: inline-flex;
    align-items: center;

    &:hover {
        background: rgb(99, 102, 241, 0.2);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_zoomBtn {
    background: rgb(255, 255, 255, 0.07);
    border: 1px solid rgb(255, 255, 255, 0.09);
    border-radius: 5px;
    color: #94a3b8;
    padding: 5px 11px;
    font-size: 14px;
    cursor: pointer;
    font-weight: 700;
    line-height: 1;
    height: 30px;
    display: inline-flex;
    align-items: center;

    &:hover {
        background: rgb(99, 102, 241, 0.2);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_reloadBtn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgb(255, 255, 255, 0.07);
    border: 1px solid rgb(255, 255, 255, 0.09);
    border-radius: 6px;
    color: #94a3b8;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    height: 30px;
    transition:
        background 0.15s,
        color 0.15s;

    &:hover {
        background: rgb(99, 102, 241, 0.2);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_reloadAge {
    font-size: 10px;
    font-weight: 400;
    opacity: 0.7;
}

.mx_FanoosDashboard_modeBtn {
    background: rgb(255, 255, 255, 0.07);
    border: 1px solid rgb(255, 255, 255, 0.09);
    border-radius: 6px;
    color: #94a3b8;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    height: 30px;
    display: inline-flex;
    align-items: center;
    transition:
        background 0.15s,
        color 0.15s;

    &:hover {
        background: rgb(99, 102, 241, 0.2);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_fsBtn {
    background: rgb(255, 255, 255, 0.07);
    border: 1px solid rgb(255, 255, 255, 0.09);
    border-radius: 6px;
    color: #94a3b8;
    padding: 5px 11px;
    font-size: 15px;
    cursor: pointer;
    height: 30px;
    display: inline-flex;
    align-items: center;
    transition:
        background 0.15s,
        color 0.15s;

    &:hover {
        background: rgb(99, 102, 241, 0.2);
        color: #c7d2fe;
    }
}

/* ── Canvas ──────────────────────────────────────────────────────── */

.mx_FanoosDashboard_canvasWrap {
    flex: 1;
    overflow: hidden;
    position: relative;
    transition: background 0.4s ease;
}

.mx_FanoosDashboard_svgWrap {
    width: 100%;
    height: 100%;
    cursor: default;
}

.mx_FanoosDashboard_empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(148, 163, 184, 0.5);
    font-size: 14px;
}

/* ── Legend Overlay ──────────────────────────────────────────────── */

.mx_FanoosDashboard_legendOverlay {
    position: absolute;
    top: 12px;
    inset-inline-start: 12px;
    background: rgb(10, 22, 40, 0.82);
    border: 1px solid rgb(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 8px 12px;
    z-index: 5;
    min-width: 130px;
    backdrop-filter: blur(4px);
    pointer-events: none;
}

.mx_FanoosDashboard_legendRow {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 2px 0;
}

.mx_FanoosDashboard_legendDot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
}

.mx_FanoosDashboard_legendLabel {
    flex: 1;
    font-size: 11px;
    font-weight: 500;
    color: rgb(226, 232, 240, 0.85);
}

.mx_FanoosDashboard_legendCount {
    font-size: 11px;
    font-weight: 700;
    color: rgb(226, 232, 240, 0.55);
    min-width: 18px;
    text-align: right;
}

.mx_FanoosDashboard_legendFooter {
    margin-top: 6px;
    padding-top: 5px;
    border-top: 1px solid rgb(255, 255, 255, 0.08);
    font-size: 10px;
    color: rgb(148, 163, 184, 0.55);
    text-align: center;
}

/* ── Hover Tooltip ────────────────────────────────────────────────── */

.mx_FanoosDashboard_hoverTip {
    position: fixed;
    z-index: 2147483647;
    pointer-events: none;
    background: rgb(10, 22, 40, 0.92);
    border: 1px solid rgb(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 10px 14px;
    min-width: 180px;
    max-width: 240px;
    box-shadow: 0 6px 24px rgb(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    font-size: 12px;
    color: #e2e8f0;
}

.mx_FanoosDashboard_htTitle {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_htScore {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 5px;
    flex-wrap: wrap;
}

.mx_FanoosDashboard_htBand {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.mx_FanoosDashboard_htPct {
    font-size: 12px;
    font-weight: 700;
}

.mx_FanoosDashboard_htBar {
    flex: 1;
    min-width: 60px;
    height: 4px;
    background: rgb(255, 255, 255, 0.1);
    border-radius: 999px;
    overflow: hidden;
}

.mx_FanoosDashboard_htBarFill {
    height: 100%;
    border-radius: 999px;
}

.mx_FanoosDashboard_htMsgCount {
    font-size: 10px;
    color: rgb(148, 163, 184, 0.65);
    margin-bottom: 4px;
}

.mx_FanoosDashboard_htKeywords {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 5px;
}

.mx_FanoosDashboard_htKwRow {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
}

.mx_FanoosDashboard_htKw {
    font-size: 10px;
    border-radius: 4px;
    padding: 1px 5px;
    font-weight: 500;

    &.pos {
        background: rgb(34, 197, 94, 0.15);
        color: #4ade80;
    }
    &.neg {
        background: rgb(239, 68, 68, 0.15);
        color: #f87171;
    }
}

.mx_FanoosDashboard_htUnread {
    font-size: 11px;
    color: #f59e0b;
    font-weight: 600;
    margin-bottom: 4px;
}

.mx_FanoosDashboard_htMembers {
    font-size: 11px;
    color: rgb(148, 163, 184, 0.8);
    line-height: 1.4;
    word-break: break-word;
}

/* ── Chat History ─────────────────────────────────────────────────── */

.mx_FanoosDashboard_chatHistory {
    flex: 1;
    overflow-y: auto;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: #f5f1e8;
    min-height: 0;

    /* Thin scrollbar */
    scrollbar-width: thin;
    scrollbar-color: rgb(0, 0, 0, 0.15) transparent;

    &::-webkit-scrollbar {
        width: 4px;
    }
    &::-webkit-scrollbar-track {
        background: transparent;
    }
    &::-webkit-scrollbar-thumb {
        background: rgb(0, 0, 0, 0.15);
        border-radius: 2px;
    }
}

.mx_FanoosDashboard_chTop {
    display: flex;
    justify-content: center;
    padding: 4px 0 6px;
    min-height: 20px;
}

.mx_FanoosDashboard_chLoading {
    font-size: 11px;
    color: rgb(148, 163, 184, 0.6);
    animation: fanoosChPulse 1s ease-in-out infinite alternate;
}

@keyframes fanoosChPulse {
    from {
        opacity: 0.4;
    }
    to {
        opacity: 1;
    }
}

.mx_FanoosDashboard_chStart {
    font-size: 10px;
    color: rgb(148, 163, 184, 0.35);
    text-align: center;
}

.mx_FanoosDashboard_chEmpty {
    padding: 16px;
    font-size: 12px;
    color: rgb(148, 163, 184, 0.5);
    text-align: center;
}

.mx_FanoosDashboard_chRow {
    display: flex;
    gap: 7px;
    align-items: flex-end;

    &.own {
        flex-direction: row-reverse;
    }
}

[dir="rtl"] .mx_FanoosDashboard_chRow {
    flex-direction: row-reverse;

    &.own {
        flex-direction: row;
    }
}

.mx_FanoosDashboard_chAvatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #7c4fa0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: #ffffff;
    flex-shrink: 0;
    margin-bottom: 2px;
}

.mx_FanoosDashboard_chContent {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: 82%;
}

.mx_FanoosDashboard_chRow.own .mx_FanoosDashboard_chContent {
    align-items: flex-end;
}

[dir="rtl"] .mx_FanoosDashboard_chRow:not(.own) .mx_FanoosDashboard_chContent {
    align-items: flex-end;
}

/* Wrapper that holds bubble + reaction button side by side */
.mx_FanoosDashboard_chBubbleRow {
    display: flex;
    align-items: center;
    gap: 4px;
}

.mx_FanoosDashboard_chSender {
    font-size: 10px;
    font-weight: 600;
    color: #7c4fa0;
    padding: 0 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 160px;
}

.mx_FanoosDashboard_chBubble {
    background: #ffffff;
    border: none;
    border-radius: 0 12px 12px 12px;
    padding: 7px 10px 5px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    word-break: break-word;
    box-shadow: 0 1px 2px rgb(0, 0, 0, 0.1);

    &.own {
        background: #d9f7be;
        border-radius: 12px 0 12px 12px;
        box-shadow: 0 1px 2px rgb(0, 0, 0, 0.08);
    }
}

.mx_FanoosDashboard_chBody {
    font-size: 12px;
    color: #111b21;
    line-height: 1.45;
    white-space: pre-wrap;
}

.mx_FanoosDashboard_chMedia {
    font-size: 11px;
    color: #94a3b8;
    font-style: italic;
}

/* ── Voice Player ─────────────────────────────────────────────────── */

.mx_FanoosDashboard_voicePlayer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0 2px;
    min-width: 160px;
    max-width: 220px;
}

.mx_FanoosDashboard_vpBtn {
    background: rgb(99, 102, 241, 0.28);
    border: 1px solid rgb(129, 140, 248, 0.4);
    border-radius: 50%;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    cursor: pointer;
    flex-shrink: 0;
    color: #c7d2fe;
    transition: background 0.15s;

    &:hover {
        background: rgb(99, 102, 241, 0.45);
    }
}

.mx_FanoosDashboard_vpBar {
    flex: 1;
    height: 4px;
    background: rgb(255, 255, 255, 0.12);
    border-radius: 999px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
}

.mx_FanoosDashboard_vpFill {
    height: 100%;
    background: #6366f1;
    border-radius: 999px;
    transition: width 0.1s linear;
}

.mx_FanoosDashboard_vpTime {
    font-size: 9px;
    color: rgb(148, 163, 184, 0.65);
    white-space: nowrap;
    flex-shrink: 0;
}

.mx_FanoosDashboard_voicePlayer.day {
    .mx_FanoosDashboard_vpBtn {
        background: rgb(99, 102, 241, 0.14);
        border-color: #a5b4fc;
        color: #4338ca;
    }
    .mx_FanoosDashboard_vpBar {
        background: rgb(0, 0, 0, 0.1);
    }
    .mx_FanoosDashboard_vpFill {
        background: #6366f1;
    }
    .mx_FanoosDashboard_vpTime {
        color: #94a3b8;
    }
}

.mx_FanoosDashboard_chTime {
    font-size: 9px;
    color: #8a9a8e;
    align-self: flex-end;
    white-space: nowrap;
}

/* ── Reactions display (chips below bubble) ─────────────────────── */

.mx_FanoosDashboard_chReactions {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-top: 3px;

    &.own {
        justify-content: flex-end;
    }
}

.mx_FanoosDashboard_chReactionChip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: rgb(255, 255, 255, 0.75);
    border: 1px solid rgb(0, 0, 0, 0.12);
    border-radius: 999px;
    font-size: 13px;
    padding: 2px 7px 2px 5px;
    cursor: pointer;
    transition:
        background 0.12s,
        transform 0.1s;
    line-height: 1;

    /* flower emoji images inside chips */
    img {
        width: 16px;
        height: 16px;
        object-fit: contain;
        vertical-align: middle;
    }

    &:hover {
        background: #ffffff;
        transform: scale(1.06);
    }
    &.mine {
        background: #d9f7be;
        border-color: rgb(0, 128, 0, 0.25);
    }
}

.mx_FanoosDashboard_chReactionCount {
    font-size: 10px;
    font-weight: 700;
    color: #444;
}

/* ── Reaction picker button (on hover) ──────────────────────────── */

.mx_FanoosDashboard_chReactionBar {
    display: flex;
    align-items: center;
    margin-top: 3px;

    &.own {
        justify-content: flex-end;
    }
}

.mx_FanoosDashboard_chReactionMore {
    background: transparent;
    border: none;
    border-radius: 999px;
    font-size: 14px;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #6366f1;
    padding: 0;
    flex-shrink: 0;
    opacity: 0.25;
    transition:
        opacity 0.15s,
        background 0.12s;

    &:hover {
        opacity: 1;
        background: rgb(99, 102, 241, 0.15);
    }
}

/* Portal container for the full EmojiPicker */
.mx_FanoosDashboard_emojiPickerPortal {
    z-index: 500;
    filter: drop-shadow(0 4px 24px rgb(0, 0, 0, 0.35));

    .mx_EmojiPicker {
        background: rgb(255, 255, 255, 0.65) !important;
        backdrop-filter: blur(14px);
        width: 280px !important;
        height: 360px !important;
    }

    .mx_EmojiPicker_list,
    .mx_EmojiPicker_category_label {
        width: 248px !important;
    }
}

/* ── Custom flower emoji inline images ───────────────────────────── */

.mx_FanoosDashboard_flowerEmoji {
    width: 1.2em;
    height: 1.2em;
    vertical-align: middle;
    display: inline-block;
}

/* ── Sent image rendering ────────────────────────────────────────── */

.mx_FanoosDashboard_chImage {
    max-width: 220px;
    max-height: 220px;
    border-radius: 10px;
    display: block;
    object-fit: contain;
}

/* ── Compose flower chips (below textarea) ───────────────────────── */

.mx_FanoosDashboard_cbFlowerChips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 3px 2px 0;
}

.mx_FanoosDashboard_cbFlowerChip {
    width: 22px;
    height: 22px;
    object-fit: contain;
    vertical-align: middle;
}

/* ── HTML editor toolbar ─────────────────────────────────────────── */

.mx_FanoosDashboard_htmlToolbar {
    display: flex;
    gap: 2px;
    padding: 2px 4px 4px;
    flex-wrap: wrap;
    align-items: center;

    button {
        background: rgb(255, 255, 255, 0.07);
        border: 1px solid rgb(255, 255, 255, 0.1);
        border-radius: 4px;
        color: #cbd5e1;
        font-size: 11px;
        min-width: 26px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0 3px;
        transition: background 0.1s;

        &:hover {
            background: rgb(99, 102, 241, 0.2);
            color: #c7d2fe;
        }
    }
}

.mx_FanoosDashboard_htmlToolbarDivider {
    width: 1px;
    height: 18px;
    background: rgb(255, 255, 255, 0.12);
    margin: 0 2px;
    flex-shrink: 0;
}

.mx_FanoosDashboard_htmlColorBtn {
    background: rgb(255, 255, 255, 0.07);
    border: 1px solid rgb(255, 255, 255, 0.1);
    border-radius: 4px;
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 700;
    width: 26px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: background 0.1s;

    span {
        background: linear-gradient(135deg, #f472b6, #818cf8, #34d399);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 900;
        line-height: 1;
    }

    &:hover {
        background: rgb(99, 102, 241, 0.2);
    }
}

/* ── HTML contenteditable input ──────────────────────────────────── */

.mx_FanoosDashboard_cbHtmlEditor {
    min-height: 52px;
    max-height: 140px;
    overflow-y: auto;
    outline: none;
    white-space: pre-wrap;
    word-break: break-word;

    &:empty::before {
        content: attr(data-placeholder);
        color: rgb(148, 163, 184, 0.5);
        pointer-events: none;
    }
}

.mx_FanoosDashboard_cbEmojiBtn {
    background: rgb(255, 255, 255, 0.07);
    border: 1px solid rgb(255, 255, 255, 0.09);
    border-radius: 6px;
    color: #94a3b8;
    font-size: 16px;
    cursor: pointer;
    padding: 6px 10px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    align-self: flex-end;
    transition:
        background 0.15s,
        color 0.15s;
    flex-shrink: 0;

    &:hover {
        background: rgb(99, 102, 241, 0.2);
        color: #c7d2fe;
    }
    &.active {
        background: rgb(99, 102, 241, 0.28);
        color: #a5b4fc;
        border-color: rgb(129, 140, 248, 0.5);
    }
}

/* ── Main chat timeline beige tint ───────────────────────────────── */

.mx_RoomView_messagePanel {
    background: #f5f1e8;
}

/* ── Send Window (unified single/multi-channel compose) ──────────── */

.mx_FanoosDashboard_sendWindow {
    position: fixed;
    min-width: 380px;
    min-height: 300px;
    background: #1e293b;
    border: 1px solid rgb(255, 255, 255, 0.12);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgb(0, 0, 0, 0.6);
    z-index: 200;
    color: #e2e8f0;
    display: flex;
    flex-direction: column;

    &.minimized {
        height: auto !important;
    }
}

.mx_FanoosDashboard_swResize {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 18px;
    height: 18px;
    cursor: se-resize;
    z-index: 10;

    &::after {
        content: "";
        position: absolute;
        right: 3px;
        bottom: 3px;
        width: 10px;
        height: 10px;
        border-right: 2px solid rgb(255, 255, 255, 0.25);
        border-bottom: 2px solid rgb(255, 255, 255, 0.25);
    }
}

.mx_FanoosDashboard_cbHdr {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    background: rgb(255, 255, 255, 0.04);
    border-bottom: 1px solid rgb(255, 255, 255, 0.07);
    cursor: grab;
    user-select: none;
    flex-shrink: 0;

    &:active {
        cursor: grabbing;
    }
}

.mx_FanoosDashboard_cbDragHandle {
    color: rgb(148, 163, 184, 0.4);
    font-size: 14px;
    line-height: 1;
    flex-shrink: 0;
    pointer-events: none;
}

.mx_FanoosDashboard_cbTitle {
    flex: 1;
    font-size: 12px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_cbCtrl {
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 13px;
    cursor: pointer;
    padding: 2px 5px;
    border-radius: 4px;
    flex-shrink: 0;
    line-height: 1;

    &:hover {
        background: rgb(255, 255, 255, 0.08);
        color: #e2e8f0;
    }
}

.mx_FanoosDashboard_cbCtrl.active {
    background: rgb(99, 102, 241, 0.25);
    color: #a5b4fc;
}

/* Body: recipients panel + main column side by side */
.mx_FanoosDashboard_swBody {
    flex: 1;
    display: flex;
    flex-direction: row;
    min-height: 0;
    overflow: hidden;
}

/* ── Recipients panel ──────────────────────────────────────────── */
.mx_FanoosDashboard_swRecipientsPanel {
    width: 220px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: #0f172a;
    border-inline-end: 1px solid rgb(255, 255, 255, 0.07);
}

.mx_FanoosDashboard_swRpHdr {
    padding: 10px 12px 6px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #475569;
    flex-shrink: 0;
}

.mx_FanoosDashboard_swRpSearch {
    margin: 0 8px 6px;
    background: rgb(255, 255, 255, 0.06);
    border: 1px solid rgb(255, 255, 255, 0.09);
    border-radius: 6px;
    color: #e2e8f0;
    padding: 5px 9px;
    font-size: 12px;
    outline: none;
    flex-shrink: 0;

    &::placeholder {
        color: rgb(148, 163, 184, 0.4);
    }
    &:focus {
        border-color: rgb(99, 102, 241, 0.55);
    }
}

.mx_FanoosDashboard_swRpList {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgb(255, 255, 255, 0.1) transparent;

    &::-webkit-scrollbar {
        width: 3px;
    }
    &::-webkit-scrollbar-thumb {
        background: rgb(255, 255, 255, 0.12);
        border-radius: 2px;
    }
}

.mx_FanoosDashboard_swRpRow {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    cursor: pointer;
    font-size: 11px;
    color: #94a3b8;
    transition: background 0.1s;

    &:hover {
        background: rgb(255, 255, 255, 0.04);
    }
    &.selected {
        color: #e2e8f0;
        background: rgb(99, 102, 241, 0.1);
    }
}

.mx_FanoosDashboard_swRpCheck {
    font-size: 10px;
    font-weight: 700;
    width: 12px;
    flex-shrink: 0;
    color: #6366f1;
}

.mx_FanoosDashboard_swRpName {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_swRpBadge {
    background: #ef4444;
    color: white;
    font-size: 8px;
    font-weight: 800;
    border-radius: 999px;
    padding: 1px 4px;
    flex-shrink: 0;
}

/* ── Main column ────────────────────────────────────────────────── */
.mx_FanoosDashboard_swMain {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

/* Multi-recipient: no chat history → compose fills the space */
.mx_FanoosDashboard_sendWindow.noHistory {
    .mx_FanoosDashboard_swMain {
        justify-content: flex-end;
    }

    .mx_FanoosDashboard_cbCompose {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .mx_FanoosDashboard_cbHtmlEditor {
        flex: 1;
        max-height: none;
        min-height: 100px;
    }
}

.mx_FanoosDashboard_swChips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 6px 10px;
    border-bottom: 1px solid rgb(255, 255, 255, 0.06);
    flex-shrink: 0;
    max-height: 80px;
    overflow-y: auto;
}

.mx_FanoosDashboard_swChip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgb(99, 102, 241, 0.18);
    border: 1px solid rgb(129, 140, 248, 0.35);
    border-radius: 999px;
    padding: 2px 8px 2px 10px;
    font-size: 11px;
    color: #c7d2fe;
    white-space: nowrap;
}

.mx_FanoosDashboard_swChipX {
    background: transparent;
    border: none;
    color: rgb(199, 210, 254, 0.55);
    font-size: 10px;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    display: flex;
    align-items: center;

    &:hover {
        color: #f87171;
    }
}

.mx_FanoosDashboard_swSentBanner {
    padding: 6px 12px;
    background: rgb(34, 197, 94, 0.15);
    color: #4ade80;
    font-size: 11px;
    font-weight: 600;
    border-bottom: 1px solid rgb(34, 197, 94, 0.2);
    flex-shrink: 0;
}

.mx_FanoosDashboard_cbCompose {
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid rgb(255, 255, 255, 0.07);
    background: #1e293b;
    flex-shrink: 0;
}

.mx_FanoosDashboard_cbInput {
    width: 100%;
    background: rgb(255, 255, 255, 0.06);
    border: 1px solid rgb(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #e2e8f0;
    padding: 8px 10px;
    font-size: 13px;
    font-family: inherit;
    resize: none;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s;

    &::placeholder {
        color: rgb(148, 163, 184, 0.45);
    }
    &:focus {
        border-color: rgb(99, 102, 241, 0.55);
    }
}

.mx_FanoosDashboard_cbSend {
    align-self: flex-end;
    background: rgb(99, 102, 241, 0.28);
    border: 1px solid rgb(129, 140, 248, 0.45);
    border-radius: 6px;
    color: #c7d2fe;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;

    &:hover:not(:disabled) {
        background: rgb(99, 102, 241, 0.45);
    }
    &:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    &.sending {
        opacity: 0.7;
    }
}

.mx_FanoosDashboard_cbMic {
    background: rgb(255, 255, 255, 0.07);
    border: 1px solid rgb(255, 255, 255, 0.09);
    border-radius: 6px;
    color: #94a3b8;
    font-size: 16px;
    cursor: pointer;
    padding: 6px 10px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    align-self: flex-end;
    transition:
        background 0.15s,
        color 0.15s;
    flex-shrink: 0;

    &:hover {
        background: rgb(99, 102, 241, 0.2);
        color: #c7d2fe;
    }
    &.recording {
        background: rgb(239, 68, 68, 0.28);
        border-color: rgb(248, 113, 113, 0.55);
        color: #f87171;
        animation: fanoosChPulse 0.8s ease-in-out infinite alternate;
    }
    &:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
}

.mx_FanoosDashboard_cbActions {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: flex-end;
}

/* ── Analysis Panel (inside Chat Box) ────────────────────────────── */

.mx_FanoosDashboard_analysisPanel {
    width: 280px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: #0f172a;
    border-inline-end: 1px solid rgb(255, 255, 255, 0.07);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgb(255, 255, 255, 0.1) transparent;

    &::-webkit-scrollbar {
        width: 3px;
    }
    &::-webkit-scrollbar-thumb {
        background: rgb(255, 255, 255, 0.12);
        border-radius: 2px;
    }
}

.mx_FanoosDashboard_apHdr {
    padding: 10px 12px 8px;
    font-size: 12px;
    font-weight: 700;
    color: #e2e8f0;
    border-bottom: 1px solid rgb(255, 255, 255, 0.05);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 6px;
}

.mx_FanoosDashboard_apHdrName {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_apScoreSection {
    padding: 8px 12px 4px;
}

.mx_FanoosDashboard_apBandRow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.mx_FanoosDashboard_apPct {
    font-size: 12px;
    font-weight: 700;
}

.mx_FanoosDashboard_apKwGroup {
    padding: 4px 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.mx_FanoosDashboard_apKwLabel {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    &.pos {
        color: #22c55e;
    }
    &.neg {
        color: #ef4444;
    }
}

.mx_FanoosDashboard_apMembers {
    padding: 8px 12px;
    border-top: 1px solid rgb(255, 255, 255, 0.05);
    margin-top: 4px;
}

.mx_FanoosDashboard_apMembersHdr {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #475569;
    margin-bottom: 6px;
}

.mx_FanoosDashboard_apMembersList {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    max-height: 100px;
    overflow-y: auto;
}

.mx_FanoosDashboard_apMemberChip {
    display: flex;
    align-items: center;
    gap: 3px;
    background: rgb(255, 255, 255, 0.06);
    border-radius: 999px;
    padding: 2px 7px 2px 3px;
}

.mx_FanoosDashboard_apMemberAv {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8px;
    font-weight: 700;
    color: #94a3b8;
}

.mx_FanoosDashboard_apMemberName {
    font-size: 10px;
    color: #cbd5e1;
    max-width: 70px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_apList {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 4px 0;
}

.mx_FanoosDashboard_apRow {
    padding: 8px 12px;
    border-bottom: 1px solid rgb(255, 255, 255, 0.04);
    transition: background 0.12s;

    &:hover {
        background: rgb(255, 255, 255, 0.03);
    }
    &.current {
        background: rgb(99, 102, 241, 0.1);
        border-inline-start: 2px solid #6366f1;
    }
}

.mx_FanoosDashboard_apRowTop {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
}

.mx_FanoosDashboard_apRoomName {
    flex: 1;
    font-size: 11px;
    font-weight: 600;
    color: #cbd5e1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_apUnread {
    background: #ef4444;
    color: white;
    font-size: 9px;
    font-weight: 800;
    border-radius: 999px;
    padding: 1px 5px;
    flex-shrink: 0;
}

.mx_FanoosDashboard_apScoreRow {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
}

.mx_FanoosDashboard_apTrack {
    flex: 1;
    height: 3px;
    background: rgb(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
}

.mx_FanoosDashboard_apFill {
    height: 100%;
    border-radius: 999px;
}

.mx_FanoosDashboard_apBand {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
    width: 48px;
    text-align: right;
}

.mx_FanoosDashboard_apKws {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-bottom: 3px;
}

.mx_FanoosDashboard_apKw {
    font-size: 9px;
    border-radius: 3px;
    padding: 1px 4px;
    font-weight: 500;

    &.pos {
        background: rgb(34, 197, 94, 0.14);
        color: #4ade80;
    }
    &.neg {
        background: rgb(239, 68, 68, 0.14);
        color: #f87171;
    }
}

.mx_FanoosDashboard_apMsgCount {
    font-size: 9px;
    color: rgb(148, 163, 184, 0.45);
}

/* Day mode overrides for analysis panel */
.mx_FanoosDashboard_analysisPanel.day {
    background: #f0f4f8;
    border-inline-end-color: #e2e8f0;

    .mx_FanoosDashboard_apHdr {
        color: #94a3b8;
        border-bottom-color: #e2e8f0;
    }
    .mx_FanoosDashboard_apRow {
        border-bottom-color: #e8edf5;
        &:hover {
            background: rgb(0, 0, 0, 0.02);
        }
        &.current {
            background: rgb(99, 102, 241, 0.08);
        }
    }
    .mx_FanoosDashboard_apRoomName {
        color: #334155;
    }
    .mx_FanoosDashboard_apTrack {
        background: rgb(0, 0, 0, 0.08);
    }
    .mx_FanoosDashboard_apKw {
        &.pos {
            background: rgb(22, 163, 74, 0.12);
            color: #15803d;
        }
        &.neg {
            background: rgb(220, 38, 38, 0.1);
            color: #b91c1c;
        }
    }
    .mx_FanoosDashboard_apMsgCount {
        color: #94a3b8;
    }
}

/* ── Info Panel ──────────────────────────────────────────────────── */

.mx_FanoosDashboard_infoPanel {
    position: absolute;
    top: 0;
    inset-inline-end: 0;
    bottom: 0;
    width: 290px;
    background: #111827;
    border-inline-start: 1px solid rgb(255, 255, 255, 0.09);
    padding: 0;
    overflow-y: auto;
    z-index: 10;
    color: #e2e8f0;
    font-size: 13px;
    box-shadow: -4px 0 24px rgb(0, 0, 0, 0.4);
}

.mx_FanoosDashboard_ipHdr {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 14px;
    border-bottom: 1px solid rgb(255, 255, 255, 0.06);
    border-inline-start: 3px solid #6366f1;
    position: sticky;
    top: 0;
    z-index: 1;
    background: #111827;
}

.mx_FanoosDashboard_ipIcon {
    font-size: 16px;
    flex-shrink: 0;
}

.mx_FanoosDashboard_ipName {
    flex: 1;
    font-weight: 600;
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_ipBand {
    font-size: 10px;
    font-weight: 700;
    border-radius: 999px;
    padding: 2px 7px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    flex-shrink: 0;
}

.mx_FanoosDashboard_ipClose {
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 14px;
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 4px;
    flex-shrink: 0;

    &:hover {
        color: #e2e8f0;
        background: rgb(255, 255, 255, 0.08);
    }
}

.mx_FanoosDashboard_ipUnread {
    padding: 8px 14px;
    color: #f59e0b;
    font-size: 12px;
    font-weight: 600;
}

.mx_FanoosDashboard_ipRow {
    display: flex;
    justify-content: space-between;
    padding: 6px 14px;
    font-size: 12px;
    color: #94a3b8;
    border-bottom: 1px solid rgb(255, 255, 255, 0.04);

    span:last-child {
        font-weight: 600;
        color: #e2e8f0;
    }
}

.mx_FanoosDashboard_ipScoreBar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
}

.mx_FanoosDashboard_ipTrack {
    flex: 1;
    height: 6px;
    background: rgb(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
}

.mx_FanoosDashboard_ipFill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.4s ease;
}

.mx_FanoosDashboard_ipPct {
    font-size: 12px;
    font-weight: 700;
    width: 32px;
    text-align: right;
    flex-shrink: 0;
}

.mx_FanoosDashboard_ipSignals {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    padding: 6px 14px;
}

.mx_FanoosDashboard_ipSigLabel {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-right: 2px;

    &.pos {
        color: #22c55e;
    }
    &.neg {
        color: #ef4444;
    }
}

.mx_FanoosDashboard_ipKw {
    font-size: 11px;
    border-radius: 4px;
    padding: 2px 6px;

    &.pos {
        background: rgb(34, 197, 94, 0.12);
        color: #4ade80;
    }
    &.neg {
        background: rgb(239, 68, 68, 0.12);
        color: #f87171;
    }
}

.mx_FanoosDashboard_ipRoomId {
    padding: 4px 14px 8px;
    font-size: 10px;
    color: #475569;
    word-break: break-all;
    font-family: monospace;
}

.mx_FanoosDashboard_ipMembers {
    border-top: 1px solid rgb(255, 255, 255, 0.06);
    padding: 10px 14px;
}

.mx_FanoosDashboard_ipMembersHdr {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #475569;
    margin-bottom: 6px;
}

.mx_FanoosDashboard_ipMembersList {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    max-height: 120px;
    overflow-y: auto;
}

.mx_FanoosDashboard_ipMemberChip {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgb(255, 255, 255, 0.06);
    border-radius: 999px;
    padding: 2px 8px 2px 4px;
}

.mx_FanoosDashboard_ipMemberAv {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: #94a3b8;
}

.mx_FanoosDashboard_ipMemberName {
    font-size: 11px;
    color: #cbd5e1;
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_ipOpenBtn {
    display: block;
    width: calc(100% - 28px);
    margin: 10px 14px 14px;
    background: rgb(99, 102, 241, 0.2);
    border: 1px solid rgb(129, 140, 248, 0.35);
    border-radius: 8px;
    color: #c7d2fe;
    font-size: 13px;
    font-weight: 600;
    padding: 8px;
    cursor: pointer;
    transition: background 0.15s;

    &:hover {
        background: rgb(99, 102, 241, 0.35);
    }
}

/* ═══════════════════════════════════════════════════════════════════
   DAY MODE OVERRIDES
   ═══════════════════════════════════════════════════════════════════ */

.mx_FanoosDashboard.day {
    background: #e8eff8;
    color: #1e293b;
}

.mx_FanoosDashboard_topBar.day {
    background: #e8edf5;
    border-bottom-color: #cbd5e0;
    color: #1e293b;

    .mx_FanoosDashboard_ctrlLabel {
        color: #64748b;
    }
    .mx_FanoosDashboard_select {
        background: rgb(255, 255, 255, 0.8);
        border-color: #cbd5e0;
        color: #1e293b;
    }
}

.mx_FanoosDashboard_ctrlBar.day {
    background: #dde4ee;
    border-bottom-color: #c5d0de;
    color: #1e293b;

    .mx_FanoosDashboard_ctrlLabel {
        color: #64748b;
    }
    .mx_FanoosDashboard_divider {
        background: rgb(0, 0, 0, 0.12);
    }
}

.mx_FanoosDashboard_lvlBtn.day {
    background: rgb(255, 255, 255, 0.7);
    border-color: #c5cfe0;
    color: #334155;

    &:hover {
        background: rgb(99, 102, 241, 0.14);
        color: #4338ca;
        border-color: #a5b4fc;
    }
    &.active {
        background: rgb(99, 102, 241, 0.2);
        border-color: #818cf8;
        color: #3730a3;
    }
}

.mx_FanoosDashboard_searchInput.day {
    background: rgb(255, 255, 255, 0.88);
    border-color: #c5cfe0;
    color: #1e293b;

    &::placeholder {
        color: #94a3b8;
    }
    &:focus {
        border-color: #818cf8;
    }
}

.mx_FanoosDashboard_navBtn.day {
    background: rgb(255, 255, 255, 0.7);
    border-color: #c5cfe0;
    color: #475569;

    &:hover {
        background: rgb(99, 102, 241, 0.14);
        color: #4338ca;
    }
}

.mx_FanoosDashboard_zoomBtn.day {
    background: rgb(255, 255, 255, 0.7);
    border-color: #c5cfe0;
    color: #475569;

    &:hover {
        background: rgb(99, 102, 241, 0.14);
        color: #4338ca;
    }
}

.mx_FanoosDashboard_reloadBtn.day {
    background: rgb(255, 255, 255, 0.7);
    border-color: #c5cfe0;
    color: #475569;

    &:hover {
        background: rgb(99, 102, 241, 0.14);
        color: #4338ca;
    }
}

.mx_FanoosDashboard_modeBtn.day {
    background: rgb(255, 255, 255, 0.7);
    border-color: #c5cfe0;
    color: #475569;

    &:hover {
        background: rgb(99, 102, 241, 0.14);
        color: #4338ca;
    }
}

.mx_FanoosDashboard_fsBtn.day {
    background: rgb(255, 255, 255, 0.7);
    border-color: #c5cfe0;
    color: #475569;

    &:hover {
        background: rgb(99, 102, 241, 0.14);
        color: #4338ca;
    }
}

.mx_FanoosDashboard_empty.day {
    color: #94a3b8;
}

.mx_FanoosDashboard_legendOverlay.day {
    background: rgb(255, 255, 255, 0.84);
    border-color: rgb(0, 0, 0, 0.12);
    box-shadow: 0 2px 12px rgb(0, 0, 0, 0.12);

    .mx_FanoosDashboard_legendLabel {
        color: #334155;
    }
    .mx_FanoosDashboard_legendCount {
        color: #64748b;
    }
    .mx_FanoosDashboard_legendFooter {
        border-top-color: rgb(0, 0, 0, 0.1);
        color: #94a3b8;
    }
}

.mx_FanoosDashboard_hoverTip.day {
    background: rgb(255, 255, 255, 0.94);
    border-color: rgb(0, 0, 0, 0.12);
    box-shadow: 0 4px 20px rgb(0, 0, 0, 0.18);
    color: #1e293b;

    .mx_FanoosDashboard_htMembers {
        color: #475569;
    }
    .mx_FanoosDashboard_htBar {
        background: rgb(0, 0, 0, 0.08);
    }
    .mx_FanoosDashboard_htUnread {
        color: #d97706;
    }
    .mx_FanoosDashboard_htMsgCount {
        color: #94a3b8;
    }
    .mx_FanoosDashboard_htKw {
        &.pos {
            background: rgb(22, 163, 74, 0.12);
            color: #15803d;
        }
        &.neg {
            background: rgb(220, 38, 38, 0.1);
            color: #b91c1c;
        }
    }
}

/* Day mode for send window */
.mx_FanoosDashboard_sendWindow.day {
    background: #f8fafc;
    border-color: #e2e8f0;
    color: #1e293b;
    box-shadow: 0 8px 32px rgb(0, 0, 0, 0.18);

    .mx_FanoosDashboard_swResize::after {
        border-color: rgb(0, 0, 0, 0.2);
    }
    .mx_FanoosDashboard_htmlToolbar button,
    .mx_FanoosDashboard_htmlColorBtn {
        background: rgb(0, 0, 0, 0.04);
        border-color: #e2e8f0;
        color: #475569;
        &:hover {
            background: rgb(99, 102, 241, 0.1);
            color: #4338ca;
        }
    }
    .mx_FanoosDashboard_htmlToolbarDivider {
        background: #cbd5e1;
    }
    .mx_FanoosDashboard_cbHtmlEditor {
        &:empty::before {
            color: #94a3b8;
        }
    }

    .mx_FanoosDashboard_cbHdr {
        background: rgb(0, 0, 0, 0.02);
        border-bottom-color: #e2e8f0;
    }
    .mx_FanoosDashboard_cbCtrl {
        color: #94a3b8;
        &:hover {
            background: rgb(0, 0, 0, 0.05);
            color: #1e293b;
        }
    }
    .mx_FanoosDashboard_cbCtrl.active {
        background: rgb(99, 102, 241, 0.18);
        color: #4338ca;
    }
    .mx_FanoosDashboard_cbInput {
        background: rgb(255, 255, 255, 0.9);
        border-color: #cbd5e0;
        color: #1e293b;
        &::placeholder {
            color: #94a3b8;
        }
        &:focus {
            border-color: #818cf8;
        }
    }
    .mx_FanoosDashboard_cbSend {
        background: rgb(99, 102, 241, 0.14);
        border-color: #a5b4fc;
        color: #4338ca;
        &:hover:not(:disabled) {
            background: rgb(99, 102, 241, 0.24);
        }
    }
    .mx_FanoosDashboard_cbCompose {
        background: #f8fafc;
        border-top-color: #e2e8f0;
    }
    .mx_FanoosDashboard_swRecipientsPanel {
        background: #f0f4f8;
        border-inline-end-color: #e2e8f0;
    }
    .mx_FanoosDashboard_swRpSearch {
        background: rgb(255, 255, 255, 0.8);
        border-color: #c5cfe0;
        color: #1e293b;
        &::placeholder {
            color: #94a3b8;
        }
    }
    .mx_FanoosDashboard_swRpRow {
        color: #64748b;
        &:hover {
            background: rgb(0, 0, 0, 0.02);
        }
        &.selected {
            color: #1e293b;
            background: rgb(99, 102, 241, 0.08);
        }
    }
    .mx_FanoosDashboard_swChip {
        background: rgb(99, 102, 241, 0.12);
        border-color: #a5b4fc;
        color: #4338ca;
    }
    .mx_FanoosDashboard_swSentBanner {
        background: rgb(22, 163, 74, 0.1);
        color: #15803d;
        border-bottom-color: rgb(22, 163, 74, 0.15);
    }

    /* Chat keeps warm colors in day mode (same as dark — already light) */
    .mx_FanoosDashboard_chLoading {
        color: #94a3b8;
    }
    .mx_FanoosDashboard_chStart {
        color: rgb(100, 116, 139, 0.45);
    }
}

.mx_FanoosDashboard_infoPanel.day {
    background: #f8fafc;
    border-inline-start-color: #e2e8f0;
    box-shadow: -4px 0 24px rgb(0, 0, 0, 0.1);
    color: #1e293b;

    .mx_FanoosDashboard_ipHdr {
        background: #f8fafc;
        border-bottom-color: #e2e8f0;
    }
    .mx_FanoosDashboard_ipClose {
        &:hover {
            color: #1e293b;
            background: rgb(0, 0, 0, 0.05);
        }
    }
    .mx_FanoosDashboard_ipUnread {
        color: #d97706;
    }
    .mx_FanoosDashboard_ipRow {
        color: #64748b;
        border-bottom-color: #f1f5f9;
        span:last-child {
            color: #1e293b;
        }
    }
    .mx_FanoosDashboard_ipTrack {
        background: #e2e8f0;
    }
    .mx_FanoosDashboard_ipKw {
        &.pos {
            background: rgb(22, 163, 74, 0.12);
            color: #15803d;
        }
        &.neg {
            background: rgb(220, 38, 38, 0.1);
            color: #b91c1c;
        }
    }
    .mx_FanoosDashboard_ipMembers {
        border-top-color: #f1f5f9;
    }
    .mx_FanoosDashboard_ipMembersHdr {
        color: #94a3b8;
    }
    .mx_FanoosDashboard_ipMemberChip {
        background: #f1f5f9;
    }
    .mx_FanoosDashboard_ipMemberAv {
        background: #cbd5e1;
        color: #475569;
    }
    .mx_FanoosDashboard_ipMemberName {
        color: #334155;
    }
    .mx_FanoosDashboard_ipOpenBtn {
        background: rgb(99, 102, 241, 0.12);
        border-color: #a5b4fc;
        color: #4338ca;
        &:hover {
            background: rgb(99, 102, 241, 0.22);
        }
    }
}

/* ── Left panel system text colour override ──────────────────────── */

.mx_SpacePanel {
    --cpd-color-text-primary: #ffffff;
    --cpd-color-text-secondary: rgb(255, 255, 255, 0.75);
    --cpd-color-text-placeholder: rgb(255, 255, 255, 0.4);
    color: #ffffff;
}

/* ── HTML body in chat history ───────────────────────────────────── */

.mx_FanoosDashboard_chHtmlBody {
    ol,
    ul {
        padding-inline-start: 1.5em;
        margin: 0.2em 0;
    }

    li {
        margin: 0.1em 0;
    }

    strong,
    b {
        font-weight: 700;
    }

    em,
    i {
        font-style: italic;
    }

    u {
        text-decoration: underline;
    }

    s,
    del {
        text-decoration: line-through;
    }
}
