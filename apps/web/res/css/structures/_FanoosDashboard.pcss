/* ── Dashboard Button in SpacePanel ──────────────────────────────── */

.mx_FanoosDashboardButton {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    width: 100%;
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    border-radius: 8px;
    cursor: pointer;
    color: $secondary-content;
    background: transparent;
    border: none;
    transition: background 0.15s ease, color 0.15s ease;
    box-sizing: border-box;

    &:hover {
        background: var(--cpd-color-bg-subtle-primary);
        color: $primary-content;
    }

    &.expanded {
        justify-content: flex-start;
    }

    svg {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
    }
}

.mx_FanoosDashboardButton_label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── Full-page Dashboard Layout ──────────────────────────────────── */

.mx_FanoosDashboard {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #0d1117;
    position: relative;
    color: #e2e8f0;
}

/* ── Control bar ─────────────────────────────────────────────────── */

.mx_FanoosDashboard_controls {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: #111827;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
    flex-wrap: wrap;
}

.mx_FanoosDashboard_lvlBtn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: rgba(226, 232, 240, 0.70);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;

    &:hover {
        background: rgba(99, 102, 241, 0.18);
        color: #c7d2fe;
    }

    &.active {
        background: rgba(99, 102, 241, 0.30);
        border-color: rgba(129, 140, 248, 0.50);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_searchWrap {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    min-width: 160px;
    position: relative;
}

.mx_FanoosDashboard_searchInput {
    flex: 1;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    color: #e2e8f0;
    padding: 4px 10px;
    font-size: 13px;
    outline: none;
    transition: border-color 0.15s;

    &::placeholder {
        color: rgba(148, 163, 184, 0.50);
    }

    &:focus {
        border-color: rgba(129, 140, 248, 0.60);
    }
}

.mx_FanoosDashboard_searchCount {
    font-size: 11px;
    color: rgba(148, 163, 184, 0.70);
    white-space: nowrap;
}

.mx_FanoosDashboard_navBtn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    color: #94a3b8;
    padding: 2px 8px;
    font-size: 14px;
    cursor: pointer;
    line-height: 1;

    &:hover {
        background: rgba(99, 102, 241, 0.20);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_zoomBtn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    color: #94a3b8;
    padding: 3px 9px;
    font-size: 13px;
    cursor: pointer;
    font-weight: 600;
    line-height: 1.2;

    &:hover {
        background: rgba(99, 102, 241, 0.20);
        color: #c7d2fe;
    }
}

/* ── Legend ──────────────────────────────────────────────────────── */

.mx_FanoosDashboard_legend {
    display: flex;
    gap: 16px;
    padding: 5px 14px;
    background: rgba(0, 0, 0, 0.20);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    flex-shrink: 0;
}

.mx_FanoosDashboard_legendItem {
    font-size: 11px;
    font-weight: 500;
    opacity: 0.85;
}

/* ── Canvas ──────────────────────────────────────────────────────── */

.mx_FanoosDashboard_canvasWrap {
    flex: 1;
    overflow: hidden;
    position: relative;
}

.mx_FanoosDashboard_svgWrap {
    width: 100%;
    height: 100%;
    cursor: default;
}

.mx_FanoosDashboard_empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(148, 163, 184, 0.50);
    font-size: 14px;
}

/* ── Info Panel ──────────────────────────────────────────────────── */

.mx_FanoosDashboard_infoPanel {
    position: absolute;
    top: 72px;
    right: 14px;
    width: 290px;
    background: #111827;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    padding: 0;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.60);
    overflow: hidden;
    z-index: 10;
    color: #e2e8f0;
    font-size: 13px;
}

.mx_FanoosDashboard_ipHdr {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    border-left: 3px solid #6366f1;
}

.mx_FanoosDashboard_ipIcon {
    font-size: 16px;
    flex-shrink: 0;
}

.mx_FanoosDashboard_ipName {
    flex: 1;
    font-weight: 600;
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_ipBand {
    font-size: 10px;
    font-weight: 700;
    border-radius: 999px;
    padding: 2px 7px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    flex-shrink: 0;
}

.mx_FanoosDashboard_ipClose {
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 14px;
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 4px;
    flex-shrink: 0;

    &:hover {
        color: #e2e8f0;
        background: rgba(255, 255, 255, 0.08);
    }
}

.mx_FanoosDashboard_ipUnread {
    padding: 8px 14px;
    color: #f59e0b;
    font-size: 12px;
    font-weight: 600;
}

.mx_FanoosDashboard_ipRow {
    display: flex;
    justify-content: space-between;
    padding: 6px 14px;
    font-size: 12px;
    color: #94a3b8;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);

    span:last-child {
        font-weight: 600;
        color: #e2e8f0;
    }
}

.mx_FanoosDashboard_ipScoreBar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
}

.mx_FanoosDashboard_ipTrack {
    flex: 1;
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
}

.mx_FanoosDashboard_ipFill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.4s ease;
}

.mx_FanoosDashboard_ipPct {
    font-size: 12px;
    font-weight: 700;
    width: 32px;
    text-align: right;
    flex-shrink: 0;
}

.mx_FanoosDashboard_ipSignals {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    padding: 6px 14px;
}

.mx_FanoosDashboard_ipSigLabel {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-right: 2px;

    &.pos { color: #22c55e; }
    &.neg { color: #ef4444; }
}

.mx_FanoosDashboard_ipKw {
    font-size: 11px;
    border-radius: 4px;
    padding: 2px 6px;

    &.pos {
        background: rgba(34, 197, 94, 0.12);
        color: #4ade80;
    }

    &.neg {
        background: rgba(239, 68, 68, 0.12);
        color: #f87171;
    }
}

.mx_FanoosDashboard_ipRoomId {
    padding: 4px 14px 8px;
    font-size: 10px;
    color: #475569;
    word-break: break-all;
    font-family: monospace;
}

.mx_FanoosDashboard_ipMembers {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 8px 14px;
}

.mx_FanoosDashboard_ipMembersHdr {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #475569;
    margin-bottom: 6px;
}

.mx_FanoosDashboard_ipMembersList {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    max-height: 100px;
    overflow-y: auto;
}

.mx_FanoosDashboard_ipMemberChip {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 999px;
    padding: 2px 8px 2px 4px;
}

.mx_FanoosDashboard_ipMemberAv {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: #94a3b8;
}

.mx_FanoosDashboard_ipMemberName {
    font-size: 11px;
    color: #cbd5e1;
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_ipOpenBtn {
    display: block;
    width: calc(100% - 28px);
    margin: 10px 14px 12px;
    background: rgba(99, 102, 241, 0.20);
    border: 1px solid rgba(129, 140, 248, 0.35);
    border-radius: 8px;
    color: #c7d2fe;
    font-size: 13px;
    font-weight: 600;
    padding: 7px;
    cursor: pointer;
    transition: background 0.15s;

    &:hover {
        background: rgba(99, 102, 241, 0.35);
    }
}
