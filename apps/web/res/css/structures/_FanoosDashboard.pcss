/* ── Dashboard Button in SpacePanel ──────────────────────────────── */

.mx_FanoosDashboardButton {
    display: flex;
    align-items: center;
    justify-content: center; /* center icon when collapsed */
    gap: var(--cpd-space-2x);
    width: 100%;
    padding: var(--cpd-space-3x) var(--cpd-space-3x);
    border-radius: 8px;
    cursor: pointer;
    color: $secondary-content;
    background: transparent;
    border: none;
    transition:
        background 0.15s ease,
        color 0.15s ease;
    box-sizing: border-box;

    &:hover {
        background: var(--cpd-color-bg-subtle-primary);
        color: $primary-content;
    }

    &.expanded {
        justify-content: flex-start;
    }

    svg {
        flex-shrink: 0;
        width: 22px;
        height: 22px;
    }
}

.mx_FanoosDashboardButton_label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── Override RoomView wrapper containment when showing Dashboard ─── */

/* contain:strict on mx_RoomView_wrapper would make it the containing block
   for position:fixed children and also clips overflow — override both */
.mx_RoomView_wrapper:has(.mx_FanoosDashboard) {
    contain: none;
    overflow: visible;
}

/* ── Full-page Dashboard Layout ──────────────────────────────────── */

.mx_FanoosDashboard {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #0a1628;
    position: relative;
    color: #e2e8f0;
}

/* ── Top bar ──────────────────────────────────────────────────────── */

.mx_FanoosDashboard_topBar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 16px;
    background: #111827;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    flex-shrink: 0;
    flex-wrap: wrap;
    color: #e2e8f0;
    min-height: 42px;
}

.mx_FanoosDashboard_title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin-right: 6px;
    white-space: nowrap;
}

.mx_FanoosDashboard_ctrlGroup {
    display: flex;
    align-items: center;
    gap: 7px;
}

.mx_FanoosDashboard_ctrlLabel {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgb(148 163 184 / 75%);
    white-space: nowrap;
}

.mx_FanoosDashboard_select {
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 6px;
    color: #e2e8f0;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    outline: none;
    height: 28px;

    &:focus {
        border-color: rgb(99 102 241 / 60%);
    }
}

/* ── Ctrl bar ─────────────────────────────────────────────────────── */

.mx_FanoosDashboard_ctrlBar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    background: #0f172a;
    border-bottom: 1px solid rgb(255 255 255 / 5%);
    flex-shrink: 0;
    flex-wrap: wrap;
    color: #e2e8f0;
    min-height: 44px;
}

.mx_FanoosDashboard_btnGroup {
    display: flex;
    align-items: center;
    gap: 4px;
}

.mx_FanoosDashboard_divider {
    width: 1px;
    height: 22px;
    background: rgb(255 255 255 / 9%);
    flex-shrink: 0;
    margin: 0 2px;
}

.mx_FanoosDashboard_spacer {
    flex: 1;
}

.mx_FanoosDashboard_lvlBtn {
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 11%);
    color: rgb(203 213 225 / 80%);
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition:
        background 0.15s,
        color 0.15s,
        border-color 0.15s;
    height: 30px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;

    &:hover {
        background: rgb(99 102 241 / 18%);
        color: #c7d2fe;
        border-color: rgb(99 102 241 / 40%);
    }

    &.active {
        background: rgb(99 102 241 / 28%);
        border-color: rgb(129 140 248 / 55%);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_searchWrap {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    min-width: 150px;
}

.mx_FanoosDashboard_searchInput {
    flex: 1;
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 6px;
    color: #e2e8f0;
    padding: 5px 10px;
    font-size: 13px;
    outline: none;
    height: 30px;
    transition: border-color 0.15s;

    &::placeholder {
        color: rgb(148 163 184 / 50%);
    }
    &:focus {
        border-color: rgb(129 140 248 / 60%);
    }
}

.mx_FanoosDashboard_searchCount {
    font-size: 11px;
    color: rgb(148 163 184 / 70%);
    white-space: nowrap;
}

.mx_FanoosDashboard_navBtn {
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: 5px;
    color: #94a3b8;
    padding: 4px 10px;
    font-size: 16px;
    cursor: pointer;
    line-height: 1;
    height: 30px;
    display: inline-flex;
    align-items: center;

    &:hover {
        background: rgb(99 102 241 / 20%);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_zoomBtn {
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: 5px;
    color: #94a3b8;
    padding: 5px 11px;
    font-size: 14px;
    cursor: pointer;
    font-weight: 700;
    line-height: 1;
    height: 30px;
    display: inline-flex;
    align-items: center;

    &:hover {
        background: rgb(99 102 241 / 20%);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_reloadBtn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: 6px;
    color: #94a3b8;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    height: 30px;
    transition:
        background 0.15s,
        color 0.15s;

    &:hover {
        background: rgb(99 102 241 / 20%);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_reloadAge {
    font-size: 10px;
    font-weight: 400;
    opacity: 0.7;
}

.mx_FanoosDashboard_modeBtn {
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: 6px;
    color: #94a3b8;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    height: 30px;
    display: inline-flex;
    align-items: center;
    transition:
        background 0.15s,
        color 0.15s;

    &:hover {
        background: rgb(99 102 241 / 20%);
        color: #c7d2fe;
    }
}

.mx_FanoosDashboard_fsBtn {
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: 6px;
    color: #94a3b8;
    padding: 5px 11px;
    font-size: 15px;
    cursor: pointer;
    height: 30px;
    display: inline-flex;
    align-items: center;
    transition:
        background 0.15s,
        color 0.15s;

    &:hover {
        background: rgb(99 102 241 / 20%);
        color: #c7d2fe;
    }
}

/* ── Canvas ──────────────────────────────────────────────────────── */

.mx_FanoosDashboard_canvasWrap {
    flex: 1;
    overflow: hidden;
    position: relative;
    transition: background 0.4s ease;
}

.mx_FanoosDashboard_svgWrap {
    width: 100%;
    height: 100%;
    cursor: default;
}

.mx_FanoosDashboard_empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(148 163 184 / 50%);
    font-size: 14px;
}

/* ── Legend Overlay ──────────────────────────────────────────────── */

.mx_FanoosDashboard_legendOverlay {
    position: absolute;
    top: 12px;
    inset-inline-start: 12px;
    background: rgb(10 22 40 / 82%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 8px;
    padding: 8px 12px;
    z-index: 5;
    min-width: 130px;
    backdrop-filter: blur(4px);
    pointer-events: none;
}

.mx_FanoosDashboard_legendRow {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 2px 0;
}

.mx_FanoosDashboard_legendDot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
}

.mx_FanoosDashboard_legendLabel {
    flex: 1;
    font-size: 11px;
    font-weight: 500;
    color: rgb(226 232 240 / 85%);
}

.mx_FanoosDashboard_legendCount {
    font-size: 11px;
    font-weight: 700;
    color: rgb(226 232 240 / 55%);
    min-width: 18px;
    text-align: right;
}

.mx_FanoosDashboard_legendFooter {
    margin-top: 6px;
    padding-top: 5px;
    border-top: 1px solid rgb(255 255 255 / 8%);
    font-size: 10px;
    color: rgb(148 163 184 / 55%);
    text-align: center;
}

/* ── Hover Tooltip ────────────────────────────────────────────────── */

.mx_FanoosDashboard_hoverTip {
    position: fixed;
    z-index: 2147483647;
    pointer-events: none;
    background: rgb(10 22 40 / 92%);
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 10px;
    padding: 10px 14px;
    min-width: 180px;
    max-width: 240px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 55%);
    backdrop-filter: blur(6px);
    font-size: 12px;
    color: #e2e8f0;
}

.mx_FanoosDashboard_htTitle {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_htScore {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 5px;
    flex-wrap: wrap;
}

.mx_FanoosDashboard_htBand {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.mx_FanoosDashboard_htPct {
    font-size: 12px;
    font-weight: 700;
}

.mx_FanoosDashboard_htBar {
    flex: 1;
    min-width: 60px;
    height: 4px;
    background: rgb(255 255 255 / 10%);
    border-radius: 999px;
    overflow: hidden;
}

.mx_FanoosDashboard_htBarFill {
    height: 100%;
    border-radius: 999px;
}

.mx_FanoosDashboard_htMsgCount {
    font-size: 10px;
    color: rgb(148 163 184 / 65%);
    margin-bottom: 4px;
}

.mx_FanoosDashboard_htKeywords {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 5px;
}

.mx_FanoosDashboard_htKwRow {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
}

.mx_FanoosDashboard_htKw {
    font-size: 10px;
    border-radius: 4px;
    padding: 1px 5px;
    font-weight: 500;

    &.pos {
        background: rgb(34 197 94 / 15%);
        color: #4ade80;
    }
    &.neg {
        background: rgb(239 68 68 / 15%);
        color: #f87171;
    }
}

.mx_FanoosDashboard_htUnread {
    font-size: 11px;
    color: #f59e0b;
    font-weight: 600;
    margin-bottom: 4px;
}

.mx_FanoosDashboard_htMembers {
    font-size: 11px;
    color: rgb(148 163 184 / 80%);
    line-height: 1.4;
    word-break: break-word;
}

/* ── Chat History ─────────────────────────────────────────────────── */

.mx_FanoosDashboard_chatHistory {
    flex: 1;
    overflow-y: auto;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: #f5f1e8;
    min-height: 0;

    /* Thin scrollbar */
    scrollbar-width: thin;
    scrollbar-color: rgb(0 0 0 / 15%) transparent;

    &::-webkit-scrollbar {
        width: 4px;
    }
    &::-webkit-scrollbar-track {
        background: transparent;
    }
    &::-webkit-scrollbar-thumb {
        background: rgb(0 0 0 / 15%);
        border-radius: 2px;
    }
}

.mx_FanoosDashboard_chTop {
    display: flex;
    justify-content: center;
    padding: 4px 0 6px;
    min-height: 20px;
}

.mx_FanoosDashboard_chLoading {
    font-size: 11px;
    color: rgb(148 163 184 / 60%);
    animation: fanoosChPulse 1s ease-in-out infinite alternate;
}

@keyframes fanoosChPulse {
    from {
        opacity: 0.4;
    }
    to {
        opacity: 1;
    }
}

.mx_FanoosDashboard_chStart {
    font-size: 10px;
    color: rgb(148 163 184 / 35%);
    text-align: center;
}

.mx_FanoosDashboard_chEmpty {
    padding: 16px;
    font-size: 12px;
    color: rgb(148 163 184 / 50%);
    text-align: center;
}

.mx_FanoosDashboard_chRow {
    display: flex;
    gap: 7px;
    align-items: flex-end;

    &.own {
        flex-direction: row-reverse;
    }
}

[dir="rtl"] .mx_FanoosDashboard_chRow {
    flex-direction: row-reverse;

    &.own {
        flex-direction: row;
    }
}

.mx_FanoosDashboard_chAvatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #7c4fa0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: #ffffff;
    flex-shrink: 0;
    margin-bottom: 2px;
}

.mx_FanoosDashboard_chContent {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: 82%;
}

.mx_FanoosDashboard_chRow.own .mx_FanoosDashboard_chContent {
    align-items: flex-end;
}

[dir="rtl"] .mx_FanoosDashboard_chRow:not(.own) .mx_FanoosDashboard_chContent {
    align-items: flex-end;
}

/* Wrapper that holds bubble + reaction button side by side */
.mx_FanoosDashboard_chBubbleRow {
    display: flex;
    align-items: center;
    gap: 4px;

    /* LTR: own (right side) → button on LEFT (inner); opponent (left side) → button on RIGHT (inner) */
    &.own {
        flex-direction: row-reverse;
    }
}

/* RTL: row/row-reverse auto-mirror gives the wrong result, so explicitly swap them.
   Own messages in RTL are on the left → button on RIGHT (inner).
   Opponent messages in RTL are on the right → button on LEFT (inner). */
[dir="rtl"] .mx_FanoosDashboard_chBubbleRow.own {
    flex-direction: row;
}

[dir="rtl"] .mx_FanoosDashboard_chBubbleRow:not(.own) {
    flex-direction: row-reverse;
}

.mx_FanoosDashboard_chSender {
    font-size: 10px;
    font-weight: 600;
    color: #7c4fa0;
    padding: 0 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 160px;
}

.mx_FanoosDashboard_chBubble {
    background: #ffffff;
    border: none;
    border-radius: 0 12px 12px 12px;
    padding: 7px 10px 5px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    word-break: break-word;
    box-shadow: 0 1px 2px rgb(0 0 0 / 10%);

    &.own {
        background: #d9f7be;
        border-radius: 12px 0 12px 12px;
        box-shadow: 0 1px 2px rgb(0 0 0 / 8%);
    }
}

.mx_FanoosDashboard_chBody {
    font-size: 12px;
    color: #111b21;
    line-height: 1.45;
    white-space: pre-wrap;
}

.mx_FanoosDashboard_chMedia {
    font-size: 11px;
    color: #94a3b8;
    font-style: italic;
}

/* ── Voice Player ─────────────────────────────────────────────────── */

.mx_FanoosDashboard_voicePlayer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0 2px;
    min-width: 160px;
    max-width: 220px;
}

.mx_FanoosDashboard_vpBtn {
    background: rgb(99 102 241 / 28%);
    border: 1px solid rgb(129 140 248 / 40%);
    border-radius: 50%;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    cursor: pointer;
    flex-shrink: 0;
    color: #c7d2fe;
    transition: background 0.15s;

    &:hover {
        background: rgb(99 102 241 / 45%);
    }
}

.mx_FanoosDashboard_vpBar {
    flex: 1;
    height: 4px;
    background: rgb(255 255 255 / 12%);
    border-radius: 999px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
}

.mx_FanoosDashboard_vpFill {
    height: 100%;
    background: #6366f1;
    border-radius: 999px;
    transition: width 0.1s linear;
}

.mx_FanoosDashboard_vpTime {
    font-size: 9px;
    color: rgb(148 163 184 / 65%);
    white-space: nowrap;
    flex-shrink: 0;
}

.mx_FanoosDashboard_voicePlayer.day {
    .mx_FanoosDashboard_vpBtn {
        background: rgb(99 102 241 / 14%);
        border-color: #a5b4fc;
        color: #4338ca;
    }
    .mx_FanoosDashboard_vpBar {
        background: rgb(0 0 0 / 10%);
    }
    .mx_FanoosDashboard_vpFill {
        background: #6366f1;
    }
    .mx_FanoosDashboard_vpTime {
        color: #94a3b8;
    }
}

.mx_FanoosDashboard_chTime {
    font-size: 9px;
    color: #8a9a8e;
    align-self: flex-end;
    white-space: nowrap;
}

/* ── Reactions display (chips below bubble) ─────────────────────── */

.mx_FanoosDashboard_chReactions {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-top: 3px;

    &.own {
        justify-content: flex-end;
    }
}

.mx_FanoosDashboard_chReactionChip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: rgb(255 255 255 / 75%);
    border: 1px solid rgb(0 0 0 / 12%);
    border-radius: 999px;
    font-size: 13px;
    padding: 2px 7px 2px 5px;
    cursor: pointer;
    transition:
        background 0.12s,
        transform 0.1s;
    line-height: 1;

    /* flower emoji images inside chips */
    img {
        width: 16px;
        height: 16px;
        object-fit: contain;
        vertical-align: middle;
    }

    &:hover {
        background: #ffffff;
        transform: scale(1.06);
    }
    &.mine {
        background: #d9f7be;
        border-color: rgb(0 128 0 / 25%);
    }
}

.mx_FanoosDashboard_chReactionCount {
    font-size: 10px;
    font-weight: 700;
    color: #444;
}

/* ── Reaction picker button (on hover) ──────────────────────────── */

.mx_FanoosDashboard_chReactionBar {
    display: flex;
    align-items: center;
    margin-top: 3px;

    &.own {
        justify-content: flex-end;
    }
}

.mx_FanoosDashboard_chReactionMore {
    background: transparent;
    border: none;
    border-radius: 999px;
    font-size: 14px;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #6366f1;
    padding: 0;
    flex-shrink: 0;
    opacity: 0;
    transition:
        opacity 0.15s,
        background 0.12s;

    &:hover {
        opacity: 1;
        background: rgb(99 102 241 / 15%);
    }
}

.mx_FanoosDashboard_chRow:hover .mx_FanoosDashboard_chReactionMore {
    opacity: 0.45;
}

/* Portal container for the full EmojiPicker */
.mx_FanoosDashboard_emojiPickerPortal {
    z-index: 500;
    filter: drop-shadow(0 4px 24px rgb(0 0 0 / 35%));

    .mx_EmojiPicker {
        background: rgb(255 255 255 / 65%) !important;
        backdrop-filter: blur(14px);
        width: 280px !important;
        height: 360px !important;
    }

    .mx_EmojiPicker_list,
    .mx_EmojiPicker_category_label {
        width: 248px !important;
    }
}

/* ── Custom flower emoji inline images ───────────────────────────── */

.mx_FanoosDashboard_flowerEmoji {
    width: 1.2em;
    height: 1.2em;
    vertical-align: middle;
    display: inline-block;
}

/* ── Sent image rendering ────────────────────────────────────────── */

.mx_FanoosDashboard_chImage {
    max-width: 220px;
    max-height: 220px;
    border-radius: 10px;
    display: block;
    object-fit: contain;
}

/* ── Compose flower chips (below textarea) ───────────────────────── */

.mx_FanoosDashboard_cbFlowerChips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 3px 2px 0;
}

.mx_FanoosDashboard_cbFlowerChip {
    width: 22px;
    height: 22px;
    object-fit: contain;
    vertical-align: middle;
}

/* ── HTML editor toolbar ─────────────────────────────────────────── */

.mx_FanoosDashboard_htmlToolbar {
    display: flex;
    gap: 2px;
    padding: 2px 4px 4px;
    flex-wrap: wrap;
    align-items: center;

    button {
        background: rgb(255 255 255 / 7%);
        border: 1px solid rgb(255 255 255 / 10%);
        border-radius: 4px;
        color: #cbd5e1;
        font-size: 11px;
        min-width: 26px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0 3px;
        transition: background 0.1s;

        &:hover {
            background: rgb(99 102 241 / 20%);
            color: #c7d2fe;
        }
    }
}

.mx_FanoosDashboard_htmlToolbarDivider {
    width: 1px;
    height: 18px;
    background: rgb(255 255 255 / 12%);
    margin: 0 2px;
    flex-shrink: 0;
}

.mx_FanoosDashboard_htmlColorBtn {
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 4px;
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 700;
    width: 26px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: background 0.1s;

    span {
        background: linear-gradient(135deg, #f472b6, #818cf8, #34d399);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 900;
        line-height: 1;
    }

    &:hover {
        background: rgb(99 102 241 / 20%);
    }
}

/* ── HTML contenteditable input ──────────────────────────────────── */

.mx_FanoosDashboard_cbHtmlEditor {
    min-height: 52px;
    max-height: 140px;
    overflow-y: auto;
    outline: none;
    white-space: pre-wrap;
    word-break: break-word;

    &:empty::before {
        content: attr(data-placeholder);
        color: rgb(148 163 184 / 50%);
        pointer-events: none;
    }
}

.mx_FanoosDashboard_cbEmojiBtn {
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: 6px;
    color: #94a3b8;
    font-size: 16px;
    cursor: pointer;
    padding: 6px 10px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    align-self: flex-end;
    transition:
        background 0.15s,
        color 0.15s;
    flex-shrink: 0;

    &:hover {
        background: rgb(99 102 241 / 20%);
        color: #c7d2fe;
    }
    &.active {
        background: rgb(99 102 241 / 28%);
        color: #a5b4fc;
        border-color: rgb(129 140 248 / 50%);
    }
}

/* ── Main chat timeline beige tint ───────────────────────────────── */
/* Apply the default beige color to .mx_RoomView_body so user-set background
   images/patterns (applied to .mx_RoomView_body via appearance.ts) remain
   visible through the transparent message panel. */

.mx_RoomView_body {
    background-color: #f5f1e8;
}

.mx_RoomView_messagePanel {
    background: transparent;
}

/* ── Send Window (unified single/multi-channel compose) ──────────── */

.mx_FanoosDashboard_sendWindow {
    position: fixed;
    min-width: 380px;
    min-height: 300px;
    background: #1e293b;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgb(0 0 0 / 60%);
    z-index: 200;
    color: #e2e8f0;
    display: flex;
    flex-direction: column;

    &.minimized {
        height: auto !important;
    }
}

.mx_FanoosDashboard_swResize {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 18px;
    height: 18px;
    cursor: se-resize;
    z-index: 10;

    &::after {
        content: "";
        position: absolute;
        right: 3px;
        bottom: 3px;
        width: 10px;
        height: 10px;
        border-right: 2px solid rgb(255 255 255 / 25%);
        border-bottom: 2px solid rgb(255 255 255 / 25%);
    }
}

.mx_FanoosDashboard_cbHdr {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    background: rgb(255 255 255 / 4%);
    border-bottom: 1px solid rgb(255 255 255 / 7%);
    cursor: grab;
    user-select: none;
    flex-shrink: 0;

    &:active {
        cursor: grabbing;
    }
}

.mx_FanoosDashboard_cbDragHandle {
    color: rgb(148 163 184 / 40%);
    font-size: 14px;
    line-height: 1;
    flex-shrink: 0;
    pointer-events: none;
}

.mx_FanoosDashboard_cbTitle {
    flex: 1;
    font-size: 12px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_cbCtrl {
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 13px;
    cursor: pointer;
    padding: 2px 5px;
    border-radius: 4px;
    flex-shrink: 0;
    line-height: 1;

    &:hover {
        background: rgb(255 255 255 / 8%);
        color: #e2e8f0;
    }
}

.mx_FanoosDashboard_cbCtrl.active {
    background: rgb(99 102 241 / 25%);
    color: #a5b4fc;
}

/* Body: recipients panel + main column side by side */
.mx_FanoosDashboard_swBody {
    flex: 1;
    display: flex;
    flex-direction: row;
    min-height: 0;
    overflow: hidden;
}

/* ── Recipients panel ──────────────────────────────────────────── */
.mx_FanoosDashboard_swRecipientsPanel {
    width: 220px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: #0f172a;
    border-inline-end: 1px solid rgb(255 255 255 / 7%);
}

.mx_FanoosDashboard_swRpHdr {
    padding: 10px 12px 6px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #475569;
    flex-shrink: 0;
}

.mx_FanoosDashboard_swRpSearch {
    margin: 0 8px 6px;
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: 6px;
    color: #e2e8f0;
    padding: 5px 9px;
    font-size: 12px;
    outline: none;
    flex-shrink: 0;

    &::placeholder {
        color: rgb(148 163 184 / 40%);
    }
    &:focus {
        border-color: rgb(99 102 241 / 55%);
    }
}

.mx_FanoosDashboard_swRpList {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 10%) transparent;

    &::-webkit-scrollbar {
        width: 3px;
    }
    &::-webkit-scrollbar-thumb {
        background: rgb(255 255 255 / 12%);
        border-radius: 2px;
    }
}

.mx_FanoosDashboard_swRpRow {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    cursor: pointer;
    font-size: 11px;
    color: #94a3b8;
    transition: background 0.1s;

    &:hover {
        background: rgb(255 255 255 / 4%);
    }
    &.selected {
        color: #e2e8f0;
        background: rgb(99 102 241 / 10%);
    }
}

.mx_FanoosDashboard_swRpCheck {
    font-size: 10px;
    font-weight: 700;
    width: 12px;
    flex-shrink: 0;
    color: #6366f1;
}

.mx_FanoosDashboard_swRpName {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_swRpBadge {
    background: #ef4444;
    color: white;
    font-size: 8px;
    font-weight: 800;
    border-radius: 999px;
    padding: 1px 4px;
    flex-shrink: 0;
}

/* ── Main column ────────────────────────────────────────────────── */
.mx_FanoosDashboard_swMain {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

/* Multi-recipient: no chat history → compose fills the space */
.mx_FanoosDashboard_sendWindow.noHistory {
    .mx_FanoosDashboard_swMain {
        justify-content: flex-end;
    }

    .mx_FanoosDashboard_cbCompose {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .mx_FanoosDashboard_cbHtmlEditor {
        flex: 1;
        max-height: none;
        min-height: 100px;
    }
}

.mx_FanoosDashboard_swChips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 6px 10px;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    flex-shrink: 0;
    max-height: 80px;
    overflow-y: auto;
}

.mx_FanoosDashboard_swChip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgb(99 102 241 / 18%);
    border: 1px solid rgb(129 140 248 / 35%);
    border-radius: 999px;
    padding: 2px 8px 2px 10px;
    font-size: 11px;
    color: #c7d2fe;
    white-space: nowrap;
}

.mx_FanoosDashboard_swChipX {
    background: transparent;
    border: none;
    color: rgb(199 210 254 / 55%);
    font-size: 10px;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    display: flex;
    align-items: center;

    &:hover {
        color: #f87171;
    }
}

.mx_FanoosDashboard_swSentBanner {
    padding: 6px 12px;
    background: rgb(34 197 94 / 15%);
    color: #4ade80;
    font-size: 11px;
    font-weight: 600;
    border-bottom: 1px solid rgb(34 197 94 / 20%);
    flex-shrink: 0;
}

.mx_FanoosDashboard_cbCompose {
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid rgb(255 255 255 / 7%);
    background: #1e293b;
    flex-shrink: 0;
}

.mx_FanoosDashboard_cbInput {
    width: 100%;
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 8px;
    color: #e2e8f0;
    padding: 8px 10px;
    font-size: 13px;
    font-family: inherit;
    resize: none;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s;

    &::placeholder {
        color: rgb(148 163 184 / 45%);
    }
    &:focus {
        border-color: rgb(99 102 241 / 55%);
    }
}

.mx_FanoosDashboard_cbSend {
    align-self: flex-end;
    background: rgb(99 102 241 / 28%);
    border: 1px solid rgb(129 140 248 / 45%);
    border-radius: 6px;
    color: #c7d2fe;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;

    &:hover:not(:disabled) {
        background: rgb(99 102 241 / 45%);
    }
    &:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    &.sending {
        opacity: 0.7;
    }
}

.mx_FanoosDashboard_cbMic {
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: 6px;
    color: #94a3b8;
    font-size: 16px;
    cursor: pointer;
    padding: 6px 10px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    align-self: flex-end;
    transition:
        background 0.15s,
        color 0.15s;
    flex-shrink: 0;

    &:hover {
        background: rgb(99 102 241 / 20%);
        color: #c7d2fe;
    }
    &.recording {
        background: rgb(239 68 68 / 28%);
        border-color: rgb(248 113 113 / 55%);
        color: #f87171;
        animation: fanoosChPulse 0.8s ease-in-out infinite alternate;
    }
    &:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
}

.mx_FanoosDashboard_cbActions {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: flex-end;
}

/* ── Analysis Panel (inside Chat Box) ────────────────────────────── */

.mx_FanoosDashboard_analysisPanel {
    width: 280px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: #0f172a;
    border-inline-end: 1px solid rgb(255 255 255 / 7%);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 10%) transparent;

    &::-webkit-scrollbar {
        width: 3px;
    }
    &::-webkit-scrollbar-thumb {
        background: rgb(255 255 255 / 12%);
        border-radius: 2px;
    }
}

.mx_FanoosDashboard_apHdr {
    padding: 10px 12px 8px;
    font-size: 12px;
    font-weight: 700;
    color: #e2e8f0;
    border-bottom: 1px solid rgb(255 255 255 / 5%);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 6px;
}

.mx_FanoosDashboard_apHdrName {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_apScoreSection {
    padding: 8px 12px 4px;
}

.mx_FanoosDashboard_apBandRow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.mx_FanoosDashboard_apPct {
    font-size: 12px;
    font-weight: 700;
}

.mx_FanoosDashboard_apKwGroup {
    padding: 4px 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.mx_FanoosDashboard_apKwLabel {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    &.pos {
        color: #22c55e;
    }
    &.neg {
        color: #ef4444;
    }
}

/* ── AI emotion panel (AnalysisPanel) ─────────────────────────────────────── */

.mx_FanoosDashboard_apEmotions {
    padding: 8px 12px;
    border-top: 1px solid rgb(255 255 255 / 5%);
    margin-top: 4px;
}

.mx_FanoosDashboard_apEmotionsHdr {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #475569;
    margin-bottom: 6px;
}

.mx_FanoosDashboard_apEmotionsList {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.mx_FanoosDashboard_apEmoRow {
    display: grid;
    grid-template-columns: 16px 68px 1fr 34px;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--cpd-color-text-secondary);

    &.top {
        color: var(--cpd-color-text-primary);
        font-weight: 600;
    }
}

.mx_FanoosDashboard_apEmoIcon {
    font-size: 13px;
    line-height: 1;
    text-align: center;
}

.mx_FanoosDashboard_apEmoLabel {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_apEmoTrack {
    height: 6px;
    background: rgb(148 163 184 / 20%);
    border-radius: 3px;
    overflow: hidden;
}

.mx_FanoosDashboard_apEmoFill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.24s ease;

    &.emo_joy {
        background: #f59e0b;
    }
    &.emo_trust {
        background: #22c55e;
    }
    &.emo_fear {
        background: #8b5cf6;
    }
    &.emo_surprise {
        background: #06b6d4;
    }
    &.emo_sadness {
        background: #3b82f6;
    }
    &.emo_disgust {
        background: #84cc16;
    }
    &.emo_anger {
        background: #ef4444;
    }
    &.emo_anticipation {
        background: #ec4899;
    }
}

.mx_FanoosDashboard_apEmoPct {
    font-variant-numeric: tabular-nums;
    text-align: end;
    font-size: 10px;
}

/* ── Hover tooltip emotion strip ───────────────────────────────────────────── */

.mx_FanoosDashboard_htEmotions {
    padding: 4px 12px 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.mx_FanoosDashboard_htEmo {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    color: var(--cpd-color-text-secondary);
}

.mx_FanoosDashboard_htEmoIcon {
    font-size: 12px;
    line-height: 1;
    text-align: center;
}

.mx_FanoosDashboard_htEmoLabel {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_htEmoPct {
    font-variant-numeric: tabular-nums;
    font-size: 9.5px;
    opacity: 0.85;
}

/* ── AI "analyzing…" indicator in toolbar ─────────────────────────────────── */

.mx_FanoosDashboard_analyzing {
    display: inline-block;
    margin-inline-start: 6px;
    font-weight: 700;
    color: #6366f1;
    animation: mx_FanoosDashboard_dots 1s steps(3, end) infinite;
}

@keyframes mx_FanoosDashboard_dots {
    0% {
        opacity: 0.3;
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: 0.3;
    }
}

.mx_FanoosDashboard_apMembers {
    padding: 8px 12px;
    border-top: 1px solid rgb(255 255 255 / 5%);
    margin-top: 4px;
}

.mx_FanoosDashboard_apMembersHdr {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #475569;
    margin-bottom: 6px;
}

.mx_FanoosDashboard_apMembersList {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    max-height: 100px;
    overflow-y: auto;
}

.mx_FanoosDashboard_apMemberChip {
    display: flex;
    align-items: center;
    gap: 3px;
    background: rgb(255 255 255 / 6%);
    border-radius: 999px;
    padding: 2px 7px 2px 3px;
}

.mx_FanoosDashboard_apMemberAv {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8px;
    font-weight: 700;
    color: #94a3b8;
}

.mx_FanoosDashboard_apMemberName {
    font-size: 10px;
    color: #cbd5e1;
    max-width: 70px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_apList {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 4px 0;
}

.mx_FanoosDashboard_apRow {
    padding: 8px 12px;
    border-bottom: 1px solid rgb(255 255 255 / 4%);
    transition: background 0.12s;

    &:hover {
        background: rgb(255 255 255 / 3%);
    }
    &.current {
        background: rgb(99 102 241 / 10%);
        border-inline-start: 2px solid #6366f1;
    }
}

.mx_FanoosDashboard_apRowTop {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
}

.mx_FanoosDashboard_apRoomName {
    flex: 1;
    font-size: 11px;
    font-weight: 600;
    color: #cbd5e1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_apUnread {
    background: #ef4444;
    color: white;
    font-size: 9px;
    font-weight: 800;
    border-radius: 999px;
    padding: 1px 5px;
    flex-shrink: 0;
}

.mx_FanoosDashboard_apScoreRow {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
}

.mx_FanoosDashboard_apTrack {
    flex: 1;
    height: 3px;
    background: rgb(255 255 255 / 8%);
    border-radius: 999px;
    overflow: hidden;
}

.mx_FanoosDashboard_apFill {
    height: 100%;
    border-radius: 999px;
}

.mx_FanoosDashboard_apBand {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
    width: 48px;
    text-align: right;
}

.mx_FanoosDashboard_apKws {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-bottom: 3px;
}

.mx_FanoosDashboard_apKw {
    font-size: 9px;
    border-radius: 3px;
    padding: 1px 4px;
    font-weight: 500;

    &.pos {
        background: rgb(34 197 94 / 14%);
        color: #4ade80;
    }
    &.neg {
        background: rgb(239 68 68 / 14%);
        color: #f87171;
    }
}

.mx_FanoosDashboard_apMsgCount {
    font-size: 9px;
    color: rgb(148 163 184 / 45%);
}

/* Day mode overrides for analysis panel */
.mx_FanoosDashboard_analysisPanel.day {
    background: #f0f4f8;
    border-inline-end-color: #e2e8f0;

    .mx_FanoosDashboard_apHdr {
        color: #94a3b8;
        border-bottom-color: #e2e8f0;
    }
    .mx_FanoosDashboard_apRow {
        border-bottom-color: #e8edf5;
        &:hover {
            background: rgb(0 0 0 / 2%);
        }
        &.current {
            background: rgb(99 102 241 / 8%);
        }
    }
    .mx_FanoosDashboard_apRoomName {
        color: #334155;
    }
    .mx_FanoosDashboard_apTrack {
        background: rgb(0 0 0 / 8%);
    }
    .mx_FanoosDashboard_apKw {
        &.pos {
            background: rgb(22 163 74 / 12%);
            color: #15803d;
        }
        &.neg {
            background: rgb(220 38 38 / 10%);
            color: #b91c1c;
        }
    }
    .mx_FanoosDashboard_apMsgCount {
        color: #94a3b8;
    }
}

/* ── Info Panel ──────────────────────────────────────────────────── */

.mx_FanoosDashboard_infoPanel {
    position: absolute;
    top: 0;
    inset-inline-end: 0;
    bottom: 0;
    width: 290px;
    background: #111827;
    border-inline-start: 1px solid rgb(255 255 255 / 9%);
    padding: 0;
    overflow-y: auto;
    z-index: 10;
    color: #e2e8f0;
    font-size: 13px;
    box-shadow: -4px 0 24px rgb(0 0 0 / 40%);
}

.mx_FanoosDashboard_ipHdr {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 14px;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    border-inline-start: 3px solid #6366f1;
    position: sticky;
    top: 0;
    z-index: 1;
    background: #111827;
}

.mx_FanoosDashboard_ipIcon {
    font-size: 16px;
    flex-shrink: 0;
}

.mx_FanoosDashboard_ipName {
    flex: 1;
    font-weight: 600;
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_ipBand {
    font-size: 10px;
    font-weight: 700;
    border-radius: 999px;
    padding: 2px 7px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    flex-shrink: 0;
}

.mx_FanoosDashboard_ipClose {
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 14px;
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 4px;
    flex-shrink: 0;

    &:hover {
        color: #e2e8f0;
        background: rgb(255 255 255 / 8%);
    }
}

.mx_FanoosDashboard_ipUnread {
    padding: 8px 14px;
    color: #f59e0b;
    font-size: 12px;
    font-weight: 600;
}

.mx_FanoosDashboard_ipRow {
    display: flex;
    justify-content: space-between;
    padding: 6px 14px;
    font-size: 12px;
    color: #94a3b8;
    border-bottom: 1px solid rgb(255 255 255 / 4%);

    span:last-child {
        font-weight: 600;
        color: #e2e8f0;
    }
}

.mx_FanoosDashboard_ipScoreBar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
}

.mx_FanoosDashboard_ipTrack {
    flex: 1;
    height: 6px;
    background: rgb(255 255 255 / 8%);
    border-radius: 999px;
    overflow: hidden;
}

.mx_FanoosDashboard_ipFill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.4s ease;
}

.mx_FanoosDashboard_ipPct {
    font-size: 12px;
    font-weight: 700;
    width: 32px;
    text-align: right;
    flex-shrink: 0;
}

.mx_FanoosDashboard_ipSignals {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    padding: 6px 14px;
}

.mx_FanoosDashboard_ipSigLabel {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-right: 2px;

    &.pos {
        color: #22c55e;
    }
    &.neg {
        color: #ef4444;
    }
}

.mx_FanoosDashboard_ipKw {
    font-size: 11px;
    border-radius: 4px;
    padding: 2px 6px;

    &.pos {
        background: rgb(34 197 94 / 12%);
        color: #4ade80;
    }
    &.neg {
        background: rgb(239 68 68 / 12%);
        color: #f87171;
    }
}

.mx_FanoosDashboard_ipRoomId {
    padding: 4px 14px 8px;
    font-size: 10px;
    color: #475569;
    word-break: break-all;
    font-family: monospace;
}

.mx_FanoosDashboard_ipMembers {
    border-top: 1px solid rgb(255 255 255 / 6%);
    padding: 10px 14px;
}

.mx_FanoosDashboard_ipMembersHdr {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #475569;
    margin-bottom: 6px;
}

.mx_FanoosDashboard_ipMembersList {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    max-height: 120px;
    overflow-y: auto;
}

.mx_FanoosDashboard_ipMemberChip {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgb(255 255 255 / 6%);
    border-radius: 999px;
    padding: 2px 8px 2px 4px;
}

.mx_FanoosDashboard_ipMemberAv {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: #94a3b8;
}

.mx_FanoosDashboard_ipMemberName {
    font-size: 11px;
    color: #cbd5e1;
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FanoosDashboard_ipOpenBtn {
    display: block;
    width: calc(100% - 28px);
    margin: 10px 14px 14px;
    background: rgb(99 102 241 / 20%);
    border: 1px solid rgb(129 140 248 / 35%);
    border-radius: 8px;
    color: #c7d2fe;
    font-size: 13px;
    font-weight: 600;
    padding: 8px;
    cursor: pointer;
    transition: background 0.15s;

    &:hover {
        background: rgb(99 102 241 / 35%);
    }
}

/* ═══════════════════════════════════════════════════════════════════
   DAY MODE OVERRIDES
   ═══════════════════════════════════════════════════════════════════ */

.mx_FanoosDashboard.day {
    background: #e8eff8;
    color: #1e293b;
}

.mx_FanoosDashboard_topBar.day {
    background: #e8edf5;
    border-bottom-color: #cbd5e0;
    color: #1e293b;

    .mx_FanoosDashboard_ctrlLabel {
        color: #64748b;
    }
    .mx_FanoosDashboard_select {
        background: rgb(255 255 255 / 80%);
        border-color: #cbd5e0;
        color: #1e293b;
    }
}

.mx_FanoosDashboard_ctrlBar.day {
    background: #dde4ee;
    border-bottom-color: #c5d0de;
    color: #1e293b;

    .mx_FanoosDashboard_ctrlLabel {
        color: #475569;
    }
    .mx_FanoosDashboard_divider {
        background: rgb(0 0 0 / 12%);
    }
    .mx_FanoosDashboard_select {
        background: rgb(255 255 255 / 85%);
        border-color: #b8c9dc;
        color: #1e293b;
    }
    .mx_FanoosDashboard_ctrlGroup {
        color: #1e293b;
    }
}

.mx_FanoosDashboard_lvlBtn.day {
    background: rgb(255 255 255 / 70%);
    border-color: #c5cfe0;
    color: #334155;

    &:hover {
        background: rgb(99 102 241 / 14%);
        color: #4338ca;
        border-color: #a5b4fc;
    }
    &.active {
        background: rgb(99 102 241 / 20%);
        border-color: #818cf8;
        color: #3730a3;
    }
}

.mx_FanoosDashboard_searchInput.day {
    background: rgb(255 255 255 / 88%);
    border-color: #c5cfe0;
    color: #1e293b;

    &::placeholder {
        color: #94a3b8;
    }
    &:focus {
        border-color: #818cf8;
    }
}

.mx_FanoosDashboard_navBtn.day {
    background: rgb(255 255 255 / 70%);
    border-color: #c5cfe0;
    color: #475569;

    &:hover {
        background: rgb(99 102 241 / 14%);
        color: #4338ca;
    }
}

.mx_FanoosDashboard_zoomBtn.day {
    background: rgb(255 255 255 / 70%);
    border-color: #c5cfe0;
    color: #475569;

    &:hover {
        background: rgb(99 102 241 / 14%);
        color: #4338ca;
    }
}

.mx_FanoosDashboard_reloadBtn.day {
    background: rgb(255 255 255 / 70%);
    border-color: #c5cfe0;
    color: #475569;

    &:hover {
        background: rgb(99 102 241 / 14%);
        color: #4338ca;
    }
}

.mx_FanoosDashboard_modeBtn.day {
    background: rgb(255 255 255 / 70%);
    border-color: #c5cfe0;
    color: #475569;

    &:hover {
        background: rgb(99 102 241 / 14%);
        color: #4338ca;
    }
}

.mx_FanoosDashboard_fsBtn.day {
    background: rgb(255 255 255 / 70%);
    border-color: #c5cfe0;
    color: #475569;

    &:hover {
        background: rgb(99 102 241 / 14%);
        color: #4338ca;
    }
}

.mx_FanoosDashboard_empty.day {
    color: #94a3b8;
}

.mx_FanoosDashboard_legendOverlay.day {
    background: rgb(255 255 255 / 84%);
    border-color: rgb(0 0 0 / 12%);
    box-shadow: 0 2px 12px rgb(0 0 0 / 12%);

    .mx_FanoosDashboard_legendLabel {
        color: #334155;
    }
    .mx_FanoosDashboard_legendCount {
        color: #64748b;
    }
    .mx_FanoosDashboard_legendFooter {
        border-top-color: rgb(0 0 0 / 10%);
        color: #94a3b8;
    }
}

.mx_FanoosDashboard_hoverTip.day {
    background: rgb(255 255 255 / 94%);
    border-color: rgb(0 0 0 / 12%);
    box-shadow: 0 4px 20px rgb(0 0 0 / 18%);
    color: #1e293b;

    .mx_FanoosDashboard_htMembers {
        color: #475569;
    }
    .mx_FanoosDashboard_htBar {
        background: rgb(0 0 0 / 8%);
    }
    .mx_FanoosDashboard_htUnread {
        color: #d97706;
    }
    .mx_FanoosDashboard_htMsgCount {
        color: #94a3b8;
    }
    .mx_FanoosDashboard_htKw {
        &.pos {
            background: rgb(22 163 74 / 12%);
            color: #15803d;
        }
        &.neg {
            background: rgb(220 38 38 / 10%);
            color: #b91c1c;
        }
    }
}

/* Day mode for send window */
.mx_FanoosDashboard_sendWindow.day {
    background: #f8fafc;
    border-color: #e2e8f0;
    color: #1e293b;
    box-shadow: 0 8px 32px rgb(0 0 0 / 18%);

    .mx_FanoosDashboard_swResize::after {
        border-color: rgb(0 0 0 / 20%);
    }
    .mx_FanoosDashboard_htmlToolbar button,
    .mx_FanoosDashboard_htmlColorBtn {
        background: rgb(0 0 0 / 4%);
        border-color: #e2e8f0;
        color: #475569;
        &:hover {
            background: rgb(99 102 241 / 10%);
            color: #4338ca;
        }
    }
    .mx_FanoosDashboard_htmlToolbarDivider {
        background: #cbd5e1;
    }
    .mx_FanoosDashboard_cbHtmlEditor {
        &:empty::before {
            color: #94a3b8;
        }
    }

    .mx_FanoosDashboard_cbHdr {
        background: rgb(0 0 0 / 2%);
        border-bottom-color: #e2e8f0;
    }
    .mx_FanoosDashboard_cbCtrl {
        color: #94a3b8;
        &:hover {
            background: rgb(0 0 0 / 5%);
            color: #1e293b;
        }
    }
    .mx_FanoosDashboard_cbCtrl.active {
        background: rgb(99 102 241 / 18%);
        color: #4338ca;
    }
    .mx_FanoosDashboard_cbInput {
        background: rgb(255 255 255 / 90%);
        border-color: #cbd5e0;
        color: #1e293b;
        &::placeholder {
            color: #94a3b8;
        }
        &:focus {
            border-color: #818cf8;
        }
    }
    .mx_FanoosDashboard_cbSend {
        background: rgb(99 102 241 / 14%);
        border-color: #a5b4fc;
        color: #4338ca;
        &:hover:not(:disabled) {
            background: rgb(99 102 241 / 24%);
        }
    }
    .mx_FanoosDashboard_cbCompose {
        background: #f8fafc;
        border-top-color: #e2e8f0;
    }
    .mx_FanoosDashboard_swRecipientsPanel {
        background: #f0f4f8;
        border-inline-end-color: #e2e8f0;
    }
    .mx_FanoosDashboard_swRpSearch {
        background: rgb(255 255 255 / 80%);
        border-color: #c5cfe0;
        color: #1e293b;
        &::placeholder {
            color: #94a3b8;
        }
    }
    .mx_FanoosDashboard_swRpRow {
        color: #64748b;
        &:hover {
            background: rgb(0 0 0 / 2%);
        }
        &.selected {
            color: #1e293b;
            background: rgb(99 102 241 / 8%);
        }
    }
    .mx_FanoosDashboard_swChip {
        background: rgb(99 102 241 / 12%);
        border-color: #a5b4fc;
        color: #4338ca;
    }
    .mx_FanoosDashboard_swSentBanner {
        background: rgb(22 163 74 / 10%);
        color: #15803d;
        border-bottom-color: rgb(22 163 74 / 15%);
    }

    /* Chat keeps warm colors in day mode (same as dark — already light) */
    .mx_FanoosDashboard_chLoading {
        color: #94a3b8;
    }
    .mx_FanoosDashboard_chStart {
        color: rgb(100 116 139 / 45%);
    }
}

.mx_FanoosDashboard_infoPanel.day {
    background: #f8fafc;
    border-inline-start-color: #e2e8f0;
    box-shadow: -4px 0 24px rgb(0 0 0 / 10%);
    color: #1e293b;

    .mx_FanoosDashboard_ipHdr {
        background: #f8fafc;
        border-bottom-color: #e2e8f0;
    }
    .mx_FanoosDashboard_ipClose {
        &:hover {
            color: #1e293b;
            background: rgb(0 0 0 / 5%);
        }
    }
    .mx_FanoosDashboard_ipUnread {
        color: #d97706;
    }
    .mx_FanoosDashboard_ipRow {
        color: #64748b;
        border-bottom-color: #f1f5f9;
        span:last-child {
            color: #1e293b;
        }
    }
    .mx_FanoosDashboard_ipTrack {
        background: #e2e8f0;
    }
    .mx_FanoosDashboard_ipKw {
        &.pos {
            background: rgb(22 163 74 / 12%);
            color: #15803d;
        }
        &.neg {
            background: rgb(220 38 38 / 10%);
            color: #b91c1c;
        }
    }
    .mx_FanoosDashboard_ipMembers {
        border-top-color: #f1f5f9;
    }
    .mx_FanoosDashboard_ipMembersHdr {
        color: #94a3b8;
    }
    .mx_FanoosDashboard_ipMemberChip {
        background: #f1f5f9;
    }
    .mx_FanoosDashboard_ipMemberAv {
        background: #cbd5e1;
        color: #475569;
    }
    .mx_FanoosDashboard_ipMemberName {
        color: #334155;
    }
    .mx_FanoosDashboard_ipOpenBtn {
        background: rgb(99 102 241 / 12%);
        border-color: #a5b4fc;
        color: #4338ca;
        &:hover {
            background: rgb(99 102 241 / 22%);
        }
    }
}

/* ── Left panel system text colour override ──────────────────────── */

.mx_SpacePanel {
    --cpd-color-text-primary: #ffffff;
    --cpd-color-text-secondary: rgb(255 255 255 / 75%);
    --cpd-color-text-placeholder: rgb(255 255 255 / 40%);
    color: #ffffff;
}

/* ── HTML body in chat history ───────────────────────────────────── */

.mx_FanoosDashboard_chHtmlBody {
    ol,
    ul {
        padding-inline-start: 1.5em;
        margin: 0.2em 0;
    }

    li {
        margin: 0.1em 0;
    }

    strong,
    b {
        font-weight: 700;
    }

    em,
    i {
        font-style: italic;
    }

    u {
        text-decoration: underline;
    }

    s,
    del {
        text-decoration: line-through;
    }
}

/* ── Main room view: fill full width ─────────────────────────────────────── */

/* Remove the small right margin on the timeline container */
.mx_RoomView_body .mx_RoomView_timeline {
    margin-right: 0 !important;
}

/* Bubble layout: allow wider messages and reduce side margins.
   Use !important on custom properties because _FanoosDashboard.pcss is imported
   before _EventBubbleTile.pcss in _components.pcss (line 63 vs 271). */
.mx_EventTile[data-layout="bubble"],
.mx_GenericEventListSummary[data-layout="bubble"] {
    --EventTile_bubble-margin-inline-start: 12px !important;
    --EventTile_bubble-margin-inline-end: 12px !important;
    --maxWidth: 94% !important;
}

/* Direct margin override for received messages (data-self="false" doesn't override start) */
.mx_EventTile[data-layout="bubble"][data-self="false"] {
    margin-inline-start: 12px !important;
}

/* Increase max-width on bubble tiles themselves */
.mx_EventTileBubble {
    max-width: min(92%, 900px) !important;
}

/* Bubble layout: timeline should fill parent (not capped at 1200px unless truly wide) */
.mx_RoomView_body[data-layout="bubble"] {
    .mx_RoomView_timeline,
    .mx_RoomView_statusArea,
    .mx_MessageComposer {
        max-width: 100% !important;
        margin-inline: 0 !important;
    }
}

/* ── RTL room header: swap name + action buttons to correct sides ─── */
/* The React component tries direction={isRtl ? "row-reverse" : "row"} on
   Compound Box, but the CSS override ensures it works reliably. */
[dir="rtl"] .mx_RoomHeader {
    flex-direction: row-reverse;
}

/* ── Dashboard tab bar ── */
.mx_FanoosDashboard_tabBar {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0 16px;
    background: rgb(255 255 255 / 6%);
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    flex-shrink: 0;
    &.day {
        background: rgb(0 0 0 / 4%);
        border-bottom-color: rgb(0 0 0 / 8%);
    }
}
.mx_FanoosDashboard_tabList {
    display: flex;
    gap: 4px;
}
.mx_FanoosDashboard_tab {
    position: relative;
    background: transparent;
    border: none;
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 500;
    color: rgb(255 255 255 / 55%);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s;
    border-bottom: 2px solid transparent;
    &.day {
        color: rgb(30 41 59 / 50%);
    }
    &:hover {
        color: rgb(255 255 255 / 90%);
    }
    &.day:hover {
        color: rgb(30 41 59 / 90%);
    }
    &.active {
        color: #6366f1;
        border-bottom-color: #6366f1;
    }
    &.day.active {
        color: #4f46e5;
        border-bottom-color: #4f46e5;
    }
}
.mx_FanoosDashboard_tabIcon {
    font-size: 14px;
}

/* ── Admin Panel ── */
.mx_FanoosDashboard_adminPanel {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    &.day {
        background: #f8fafc;
    }
    background: rgb(15 25 50 / 70%);
}
/* Multi-server admin bar */
.mx_FanoosDashboard_adminServerBar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-bottom: 1px solid rgb(148, 163, 184, 0.12);
    background: rgb(99, 102, 241, 0.04);
    font-size: 11px;
}
.mx_FanoosDashboard_adminServerBarLabel {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--cpd-color-text-secondary);
    opacity: 0.7;
    margin-inline-end: 4px;
}
.mx_FanoosDashboard_adminServerChipWrap {
    display: inline-flex;
    align-items: center;
    gap: 2px;
}
.mx_FanoosDashboard_adminServerChip {
    background: rgb(148, 163, 184, 0.14);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 11px;
    color: var(--cpd-color-text-primary);
    cursor: pointer;
    &:hover {
        background: rgb(148, 163, 184, 0.22);
    }
    &.active {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff;
        border-color: transparent;
        font-weight: 600;
    }
}
.mx_FanoosDashboard_adminServerChipDel {
    background: transparent;
    border: none;
    color: var(--cpd-color-text-secondary);
    cursor: pointer;
    padding: 2px 6px;
    font-size: 11px;
    border-radius: 6px;
    &:hover {
        color: #ef4444;
        background: rgb(239, 68, 68, 0.12);
    }
}
.mx_FanoosDashboard_adminServerAdd {
    background: transparent;
    border: 1px dashed rgb(148, 163, 184, 0.55);
    color: var(--cpd-color-text-secondary);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 11px;
    cursor: pointer;
    margin-inline-start: 4px;
    &:hover {
        border-color: #6366f1;
        color: #6366f1;
    }
}
.mx_FanoosDashboard_adminAddServerForm {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 16px 12px;
    background: rgb(99, 102, 241, 0.06);
    border-bottom: 1px solid rgb(99, 102, 241, 0.15);
}

.mx_FanoosDashboard_adminSubTabs {
    display: flex;
    gap: 4px;
    padding: 8px 16px 0;
    border-bottom: 1px solid rgb(255 255 255 / 8%);
    flex-shrink: 0;
    &.day {
        border-bottom-color: rgb(0 0 0 / 6%);
    }
}
.mx_FanoosDashboard_adminSubTab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 500;
    color: rgb(255 255 255 / 50%);
    cursor: pointer;
    transition: color 0.15s;
    &.day {
        color: rgb(30 41 59 / 50%);
    }
    &:hover {
        color: #fff;
    }
    &.day:hover {
        color: #1e293b;
    }
    &.active {
        color: #6366f1;
        border-bottom-color: #6366f1;
    }
    &.day.active {
        color: #4f46e5;
        border-bottom-color: #4f46e5;
    }
}
.mx_FanoosDashboard_adminSearchRow {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    flex-shrink: 0;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    &.day {
        border-bottom-color: rgb(0 0 0 / 6%);
    }
}
.mx_FanoosDashboard_adminSearch {
    flex: 1;
    background: rgb(255 255 255 / 8%);
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    color: #fff;
    outline: none;
    &.day {
        background: #fff;
        border-color: #cbd5e1;
        color: #1e293b;
    }
    &:focus {
        border-color: #6366f1;
    }
}
.mx_FanoosDashboard_adminReload {
    background: rgb(255 255 255 / 8%);
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 14px;
    color: #fff;
    cursor: pointer;
    &.day {
        background: #e2e8f0;
        color: #1e293b;
    }
    &:hover {
        background: rgb(99 102 241 / 20%);
    }
}
.mx_FanoosDashboard_adminLoading,
.mx_FanoosDashboard_adminError,
.mx_FanoosDashboard_adminEmpty {
    padding: 24px;
    text-align: center;
    font-size: 13px;
    color: rgb(255 255 255 / 50%);
    &.day {
        color: rgb(30 41 59 / 50%);
    }
}
.mx_FanoosDashboard_adminError {
    color: #f87171;
}
.mx_FanoosDashboard_adminList {
    flex: 1;
    overflow-y: auto;
    padding: 8px 0;
}
.mx_FanoosDashboard_adminListHeader {
    display: grid;
    grid-template-columns: 1fr 100px 180px;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(255 255 255 / 35%);
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    &.day {
        color: rgb(30 41 59 / 40%);
        border-bottom-color: rgb(0 0 0 / 6%);
    }
}
.mx_FanoosDashboard_adminRow {
    display: grid;
    grid-template-columns: 1fr 100px 180px;
    align-items: center;
    padding: 8px 16px;
    border-bottom: 1px solid rgb(255 255 255 / 4%);
    transition: background 0.12s;
    &.day {
        border-bottom-color: rgb(0 0 0 / 4%);
    }
    &:hover {
        background: rgb(99 102 241 / 6%);
    }
    &.deactivated {
        opacity: 0.45;
    }
    &.admin {
        background: rgb(99 102 241 / 4%);
    }
}
.mx_FanoosDashboard_adminUserInfo {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}
.mx_FanoosDashboard_adminUserName {
    font-size: 13px;
    font-weight: 500;
    color: #fff;
    &.day {
        color: #1e293b;
    }
}
.mx_FanoosDashboard_adminUserId {
    font-size: 10px;
    color: rgb(255 255 255 / 40%);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    &.day {
        color: rgb(30 41 59 / 45%);
    }
}
.mx_FanoosDashboard_adminBadge {
    font-size: 9px;
    background: #6366f1;
    color: #fff;
    border-radius: 3px;
    padding: 1px 5px;
    width: fit-content;
}
.mx_FanoosDashboard_adminStatus {
    font-size: 11px;
    color: rgb(255 255 255 / 50%);
    &.day {
        color: rgb(30 41 59 / 50%);
    }
}
.mx_FanoosDashboard_adminActions {
    display: flex;
    align-items: center;
    gap: 4px;
}
.mx_FanoosDashboard_adminEditForm {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
}
.mx_FanoosDashboard_adminEditInput {
    background: rgb(255 255 255 / 8%);
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 5px;
    padding: 3px 7px;
    font-size: 11px;
    color: #fff;
    width: 110px;
    outline: none;
    &.day {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #1e293b;
    }
}
.mx_FanoosDashboard_adminBtnEdit,
.mx_FanoosDashboard_adminBtnSave,
.mx_FanoosDashboard_adminBtnCancel,
.mx_FanoosDashboard_adminBtnBan,
.mx_FanoosDashboard_adminBtnDelete,
.mx_FanoosDashboard_adminBtnToggleAdmin {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 3px 7px;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.12s;
    &:hover {
        background: rgb(255 255 255 / 10%);
    }
    &.day:hover {
        background: rgb(0 0 0 / 6%);
    }
}
.mx_FanoosDashboard_adminBtnSave {
    color: #34d399;
}
.mx_FanoosDashboard_adminBtnDanger {
    background: #ef4444;
    color: #fff;
    border: none;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12px;
    cursor: pointer;
    &:hover {
        background: #dc2626;
    }
}
.mx_FanoosDashboard_adminConfirmOverlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 55%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
}
.mx_FanoosDashboard_adminConfirmBox {
    background: #1e293b;
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 260px;
    text-align: center;
    color: #fff;
    font-size: 14px;
    &.day {
        background: #fff;
        color: #1e293b;
    }
}

/* Spaces & Rooms view */
.mx_FanoosDashboard_adminSpaceBlock {
    padding: 4px 0;
    border-bottom: 1px solid rgb(255 255 255 / 5%);
    &.day {
        border-bottom-color: rgb(0 0 0 / 4%);
    }
}
.mx_FanoosDashboard_adminSpaceRow,
.mx_FanoosDashboard_adminRoomRow {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    &:hover {
        background: rgb(99 102 241 / 6%);
    }
}
.mx_FanoosDashboard_adminRoomRow {
    padding-left: 40px;
}
.mx_FanoosDashboard_adminExpand {
    background: transparent;
    border: none;
    color: rgb(255 255 255 / 50%);
    cursor: pointer;
    font-size: 10px;
    width: 16px;
    &.day {
        color: rgb(30 41 59 / 40%);
    }
}
.mx_FanoosDashboard_adminSpaceName {
    font-size: 13px;
    font-weight: 600;
    color: #e2e8f0;
    flex: 1;
    cursor: pointer;
    &.day {
        color: #1e293b;
    }
    &:hover {
        text-decoration: underline dotted;
    }
}
.mx_FanoosDashboard_adminRoomName {
    font-size: 12px;
    color: rgb(255 255 255 / 70%);
    flex: 1;
    cursor: pointer;
    &.day {
        color: rgb(30 41 59 / 75%);
    }
    &:hover {
        text-decoration: underline dotted;
    }
}
/* ── Add-server form (Admin servers tab) ─────────────────────────────────── */

.mx_FanoosDashboard_adminAddServerInput {
    background: rgb(15 23 42 / 4%);
    border: 1px solid rgb(148 163 184 / 30%);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    color: inherit;
    font-family: inherit;
}
.mx_FanoosDashboard_adminAddServerError {
    background: rgb(239 68 68 / 12%);
    color: #ef4444;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
}
.mx_FanoosDashboard_adminAddServerActions {
    display: flex;
    gap: 6px;
    justify-content: flex-end;
}
.mx_FanoosDashboard_adminAddServerBtnPrimary,
.mx_FanoosDashboard_adminAddServerBtnGhost {
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    &:disabled {
        opacity: 0.5;
        cursor: default;
    }
}
.mx_FanoosDashboard_adminAddServerBtnPrimary {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #fff;
    &:hover:not(:disabled) {
        opacity: 0.85;
    }
}
.mx_FanoosDashboard_adminAddServerBtnGhost {
    background: transparent;
    border: 1px solid rgb(148 163 184 / 40%);
    color: var(--cpd-color-text-primary);
    &:hover:not(:disabled) {
        background: rgb(148 163 184 / 12%);
    }
}

/* ── Server Teams view (Admin servers → Teams sub-tab) ───────────────────── */

.mx_FanoosDashboard_stv {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 500px;
    gap: 8px;
    padding: 8px 12px 12px;
}
.mx_FanoosDashboard_stvHeader {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-shrink: 0;
}
.mx_FanoosDashboard_stvSearch {
    flex: 1;
    background: rgb(15 23 42 / 4%);
    border: 1px solid rgb(148 163 184 / 30%);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    color: inherit;
}
.mx_FanoosDashboard_stvReload {
    background: transparent;
    border: 1px solid rgb(148 163 184 / 40%);
    border-radius: 6px;
    padding: 4px 10px;
    color: var(--cpd-color-text-primary);
    cursor: pointer;
    &:hover:not(:disabled) {
        background: rgb(148 163 184 / 12%);
    }
}
.mx_FanoosDashboard_stvCount {
    font-size: 11px;
    color: var(--cpd-color-text-secondary);
    font-variant-numeric: tabular-nums;
}
.mx_FanoosDashboard_stvError {
    background: rgb(239 68 68 / 12%);
    color: #ef4444;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
}
.mx_FanoosDashboard_stvCanvas {
    flex: 1;
    position: relative;
    min-height: 400px;
    overflow: hidden;
}
.mx_FanoosDashboard_stvEmpty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cpd-color-text-secondary);
    opacity: 0.7;
    font-size: 12px;
    pointer-events: none;
}

/* ── Reactions on external-server messages ────────────────────────────── */

.mx_FanoosDashboard_smpReactions {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 4px;
    padding-left: 6px;
}

.mx_FanoosDashboard_smpReactionChip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px 7px;
    font-size: 11.5px;
    background: rgb(148 163 184 / 12%);
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
    color: var(--cpd-color-text-primary);
    transition: background 0.1s ease;

    &:hover {
        background: rgb(148 163 184 / 22%);
    }
    &.mine {
        background: rgb(99 102 241 / 18%);
        border-color: rgb(99 102 241 / 45%);
    }
}

.mx_FanoosDashboard_smpReactionCount {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
    font-size: 10.5px;
}

.mx_FanoosDashboard_smpReactBtn {
    position: absolute;
    top: 0;
    right: -32px;
    background: rgb(148 163 184 / 12%);
    border: none;
    border-radius: 999px;
    padding: 2px 6px;
    font-size: 11px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.12s ease;
    color: var(--cpd-color-text-secondary);

    &:hover {
        background: rgb(99 102 241 / 22%);
        color: var(--cpd-color-text-primary);
    }
}
.mx_FanoosDashboard_chBubbleRow:hover .mx_FanoosDashboard_smpReactBtn {
    opacity: 0.85;
}

.mx_FanoosDashboard_smpReactPicker {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 4px;
    z-index: 100;
    background: var(--cpd-color-bg-canvas-default);
    border: 1px solid rgb(148, 163, 184, 0.3);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgb(0, 0, 0, 0.35);
}

/* Overlay backdrop for the message pane — pins it centered above content. */
.mx_FanoosDashboard_swOverlay {
    position: fixed;
    inset: 0;
    background: rgb(0 0 0 / 45%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
}

/* Add user button */
.mx_FanoosDashboard_adminBtnAdd {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
    white-space: nowrap;
    &:hover {
        opacity: 0.85;
    }
}

/* Add user form */
.mx_FanoosDashboard_adminAddUserForm {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 16px;
    background: rgb(99 102 241 / 6%);
    border-bottom: 1px solid rgb(99 102 241 / 15%);
    flex-shrink: 0;
    &.day {
        background: rgb(99 102 241 / 4%);
        border-bottom-color: rgb(99 102 241 / 12%);
    }
}
.mx_FanoosDashboard_adminNewUserIdRow {
    display: flex;
    align-items: center;
    gap: 8px;
}
.mx_FanoosDashboard_adminDomainHint {
    font-size: 11px;
    color: rgb(255 255 255 / 40%);
    white-space: nowrap;
    &.day {
        color: rgb(30 41 59 / 40%);
    }
}
.mx_FanoosDashboard_adminPwdRow {
    display: flex;
    align-items: center;
    gap: 6px;
}
.mx_FanoosDashboard_adminBtnRandom {
    background: rgb(255 255 255 / 8%);
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 14px;
    cursor: pointer;
    flex-shrink: 0;
    &.day {
        background: #e2e8f0;
    }
    &:hover {
        background: rgb(99 102 241 / 25%);
    }
}
.mx_FanoosDashboard_adminAdminToggle {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: rgb(255 255 255 / 70%);
    cursor: pointer;
    &.day {
        color: rgb(30 41 59 / 70%);
    }
}
.mx_FanoosDashboard_adminFormBtns {
    display: flex;
    gap: 6px;
}

/* Room block for member management */
.mx_FanoosDashboard_adminRoomBlock {
    border-bottom: 1px solid rgb(255 255 255 / 4%);
    &.day {
        border-bottom-color: rgb(0 0 0 / 3%);
    }
}

/* Members button */
.mx_FanoosDashboard_adminBtnMembers {
    background: rgb(255 255 255 / 7%);
    border: none;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    color: rgb(255 255 255 / 60%);
    cursor: pointer;
    flex-shrink: 0;
    &.day {
        background: #e2e8f0;
        color: #475569;
    }
    &:hover,
    &.active {
        background: rgb(99 102 241 / 20%);
        color: #a5b4fc;
    }
    &.day:hover,
    &.day.active {
        background: rgb(99 102 241 / 12%);
        color: #4f46e5;
    }
}

/* Members panel */
.mx_FanoosDashboard_adminMembersPanel {
    background: rgb(0 0 0 / 15%);
    border-top: 1px solid rgb(255 255 255 / 5%);
    padding: 6px 16px 8px 52px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    &.day {
        background: rgb(0 0 0 / 3%);
        border-top-color: rgb(0 0 0 / 4%);
    }
}
.mx_FanoosDashboard_adminMemberRow {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 2px 0;
}
.mx_FanoosDashboard_adminMemberName {
    flex: 1;
    font-size: 11px;
    color: rgb(255 255 255 / 60%);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    &.day {
        color: #475569;
    }
}
.mx_FanoosDashboard_adminBtnKick {
    background: transparent;
    border: 1px solid rgb(239 68 68 / 30%);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    color: #f87171;
    cursor: pointer;
    flex-shrink: 0;
    &:hover {
        background: rgb(239 68 68 / 15%);
    }
}
.mx_FanoosDashboard_adminAddMemberRow {
    margin-top: 4px;
    padding-top: 4px;
    border-top: 1px solid rgb(255 255 255 / 5%);
    &.day {
        border-top-color: rgb(0 0 0 / 6%);
    }
}
.mx_FanoosDashboard_adminMemberSuggestion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 3px 0;
    font-size: 12px;
    color: rgb(255 255 255 / 70%);
    gap: 8px;
    &.day {
        color: #334155;
    }
}
.mx_FanoosDashboard_adminBtnInvite {
    background: rgb(34 197 94 / 15%);
    border: 1px solid rgb(34 197 94 / 30%);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 700;
    color: #4ade80;
    cursor: pointer;
    flex-shrink: 0;
    &:hover {
        background: rgb(34 197 94 / 25%);
    }
}

/* ═══════════════════════════════════════════════════════════════════════════
   User Table — grid layout
═══════════════════════════════════════════════════════════════════════════ */

/* The shared grid template used by header + data rows */
$userCols: 1fr 68px 90px 86px 86px 138px;

.mx_FanoosDashboard_adminUserTable {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
}

/* ── Column header row ── */
.mx_FanoosDashboard_adminTableHead {
    display: grid;
    grid-template-columns: $userCols;
    padding: 0 12px;
    border-bottom: 1px solid rgb(255 255 255 / 8%);
    position: sticky;
    top: 0;
    background: #1a1f2e;
    z-index: 1;
    &.day {
        border-bottom-color: rgb(0 0 0 / 10%);
        background: #f0f4fb;
    }
}
.mx_FanoosDashboard_adminTh {
    padding: 7px 6px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(255 255 255 / 35%);
    white-space: nowrap;
    &.day {
        color: rgb(30 41 59 / 40%);
    }
}
.mx_FanoosDashboard_adminThBtn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    display: flex;
    align-items: center;
    gap: 4px;
    &:hover {
        color: #a5b4fc;
    }
    &.day:hover {
        color: #4f46e5;
    }
}

/* ── Data rows ── */
.mx_FanoosDashboard_adminUserRow {
    display: grid;
    grid-template-columns: $userCols;
    align-items: center;
    padding: 0 12px;
    min-height: 52px;
    border-bottom: 1px solid rgb(255 255 255 / 4%);
    transition: background 0.1s;
    &.day {
        border-bottom-color: rgb(0 0 0 / 4%);
    }
    &:hover {
        background: rgb(99 102 241 / 6%);
    }
    &.deactivated {
        opacity: 0.45;
    }
    &.admin .mx_FanoosDashboard_adminUserDisplayName {
        color: #a5b4fc;
    }
    &.admin.day .mx_FanoosDashboard_adminUserDisplayName {
        color: #4f46e5;
    }
}

/* ── Per-column cells ── */
.mx_FanoosDashboard_adminTdUser {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 8px 0;
}
.mx_FanoosDashboard_adminTdRole,
.mx_FanoosDashboard_adminTdStatus,
.mx_FanoosDashboard_adminTdDate,
.mx_FanoosDashboard_adminTdActivity {
    font-size: 11px;
    color: rgb(255 255 255 / 50%);
    white-space: nowrap;
    padding: 0 6px;
    &.day {
        color: rgb(30 41 59 / 55%);
    }
}

/* ── Avatar ── */
.mx_FanoosDashboard_adminUserAvatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    overflow: hidden;
}
.mx_FanoosDashboard_adminUserAvatarImg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
}

/* ── Name + matrix ID ── */
.mx_FanoosDashboard_adminUserIdent {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.mx_FanoosDashboard_adminUserDisplayName {
    font-size: 13px;
    font-weight: 600;
    color: #e2e8f0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: text;
    &.day {
        color: #1e293b;
    }
    &:hover {
        text-decoration: underline dotted;
        text-underline-offset: 3px;
    }
}
.mx_FanoosDashboard_adminUserMatrixId {
    font-size: 11px;
    color: rgb(255 255 255 / 35%);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    &.day {
        color: rgb(30 41 59 / 40%);
    }
}

/* ── Badges ── */
.mx_FanoosDashboard_adminBadgeAdmin {
    display: inline-block;
    background: rgb(99 102 241 / 20%);
    border: 1px solid rgb(99 102 241 / 35%);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 9px;
    font-weight: 700;
    color: #a5b4fc;
    text-transform: uppercase;
    &.day {
        background: rgb(99 102 241 / 10%);
        color: #4f46e5;
        border-color: rgb(99 102 241 / 25%);
    }
}
.mx_FanoosDashboard_adminBadgeStatus {
    display: inline-block;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
    background: rgb(34 197 94 / 15%);
    color: #4ade80;
    &.banned {
        background: rgb(239 68 68 / 15%);
        color: #f87171;
    }
    &.day {
        background: rgb(34 197 94 / 12%);
        color: #16a34a;
    }
    &.banned.day {
        background: rgb(239 68 68 / 10%);
        color: #dc2626;
    }
}

/* ── Action buttons ── */
.mx_FanoosDashboard_adminUserActions {
    display: flex;
    gap: 1px;
    justify-content: flex-end;
}
.mx_FanoosDashboard_adminUABtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 5px 6px;
    cursor: pointer;
    color: rgb(255 255 255 / 50%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
        background 0.12s,
        color 0.12s;
    &.day {
        color: rgb(30 41 59 / 45%);
    }
    &:hover {
        background: rgb(99 102 241 / 15%);
        color: #a5b4fc;
    }
    &.day:hover {
        color: #4f46e5;
    }
    &.danger:hover {
        background: rgb(239 68 68 / 15%);
        color: #f87171;
    }
    &.danger.day:hover {
        color: #dc2626;
    }
    &.active {
        color: #f59e0b;
    }
    &.active.day {
        color: #d97706;
    }
    &.copied {
        color: #4ade80;
    }
}

/* ── Edit row ── */
.mx_FanoosDashboard_adminEditRow {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    flex: 1;
    min-width: 0;
}
.mx_FanoosDashboard_adminUserEditBlock {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
}

/* ── Avatar picker (create + edit forms) ── */
.mx_FanoosDashboard_adminFormAvatarWrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    overflow: hidden;
    &:hover .mx_FanoosDashboard_adminFormAvatarOverlay {
        opacity: 1;
    }
}
.mx_FanoosDashboard_adminFormAvatarImg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}
.mx_FanoosDashboard_adminFormAvatarOverlay {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 45%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.15s;
    color: #fff;
}
.mx_FanoosDashboard_adminAddUserTop {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 10px;
}
.mx_FanoosDashboard_adminAddUserFields {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
}

/* ─── Inline name edit input ─────────────────────────────────────────────── */
.mx_FanoosDashboard_adminUserInlineInput {
    font-size: 13px;
    font-weight: 600;
    color: #e2e8f0;
    background: rgb(99 102 241 / 12%);
    border: 1px solid #6366f1;
    border-radius: 4px;
    padding: 1px 6px;
    outline: none;
    width: 100%;
    min-width: 0;
    &.day {
        color: #1e293b;
        background: rgb(99 102 241 / 7%);
    }
}

/* ─── Floating user edit window ──────────────────────────────────────────── */
.mx_FanoosDashboard_adminFloatWin {
    position: fixed;
    z-index: 9000;
    width: 360px;
    background: #1e2438;
    border: 1px solid rgb(99 102 241 / 30%);
    border-radius: 12px;
    box-shadow:
        0 16px 48px rgb(0 0 0 / 55%),
        0 0 0 1px rgb(255 255 255 / 4%);
    overflow: hidden;
    &.day {
        background: #ffffff;
        border-color: rgb(99 102 241 / 20%);
        box-shadow: 0 16px 48px rgb(0 0 0 / 18%);
    }
}
.mx_FanoosDashboard_adminFloatHead {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    background: rgb(99 102 241 / 12%);
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    cursor: grab;
    user-select: none;
    &.day {
        background: rgb(99 102 241 / 6%);
        border-bottom-color: rgb(0 0 0 / 7%);
    }
    &:active {
        cursor: grabbing;
    }
}
.mx_FanoosDashboard_adminFloatTitle {
    flex: 1;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(255 255 255 / 60%);
    &.day {
        color: rgb(30 41 59 / 50%);
    }
}
.mx_FanoosDashboard_adminFloatClose {
    background: transparent;
    border: none;
    color: rgb(255 255 255 / 40%);
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    padding: 0 2px;
    border-radius: 4px;
    &.day {
        color: rgb(30 41 59 / 40%);
    }
    &:hover {
        color: #fff;
        background: rgb(255 255 255 / 10%);
    }
    &.day:hover {
        color: #1e293b;
        background: rgb(0 0 0 / 6%);
    }
}
.mx_FanoosDashboard_adminFloatBody {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    overflow-y: auto;
    max-height: calc(90vh - 52px);
}

/* ─── Float window: Groups section ────────────────────────────────────────── */
.mx_FanoosDashboard_adminFloatSection {
    border-top: 1px solid rgb(255 255 255 / 7%);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    &.day {
        border-top-color: rgb(0 0 0 / 7%);
    }
}
.mx_FanoosDashboard_adminFloatSectionHead {
    display: flex;
    align-items: center;
    gap: 6px;
}
.mx_FanoosDashboard_adminFloatSectionTitle {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(255 255 255 / 35%);
    flex: 1;
    &.day {
        color: rgb(30 41 59 / 40%);
    }
}
.mx_FanoosDashboard_adminFloatSectionCount {
    font-size: 10px;
    background: rgb(255 255 255 / 8%);
    border-radius: 10px;
    padding: 1px 7px;
    color: rgb(255 255 255 / 40%);
    &.day {
        background: rgb(0 0 0 / 6%);
        color: rgb(30 41 59 / 45%);
    }
}
.mx_FanoosDashboard_adminFloatSpinner {
    width: 12px;
    height: 12px;
    border: 2px solid rgb(255 255 255 / 10%);
    border-top-color: #6366f1;
    border-radius: 50%;
    animation: fanoos_spin 0.7s linear infinite;
    flex-shrink: 0;
}
.mx_FanoosDashboard_adminFloatRoomList {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: 200px;
    overflow-y: auto;
}
.mx_FanoosDashboard_adminFloatRoomChip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    background: rgb(255 255 255 / 5%);
    border-radius: 8px;
    border: 1px solid rgb(255 255 255 / 6%);
    transition: background 0.1s;
    &.day {
        background: rgb(0 0 0 / 4%);
        border-color: rgb(0 0 0 / 7%);
    }
    &:hover {
        background: rgb(99 102 241 / 8%);
    }
    &.busy {
        opacity: 0.5;
        pointer-events: none;
    }
}
.mx_FanoosDashboard_adminFloatRoomIcon {
    font-size: 12px;
    flex-shrink: 0;
    line-height: 1;
}
.mx_FanoosDashboard_adminFloatRoomName {
    flex: 1;
    font-size: 12px;
    color: #cbd5e1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    &.day {
        color: #334155;
    }
}
.mx_FanoosDashboard_adminFloatRoomRemove {
    background: transparent;
    border: none;
    color: rgb(255 255 255 / 25%);
    cursor: pointer;
    font-size: 11px;
    padding: 1px 3px;
    border-radius: 3px;
    line-height: 1;
    flex-shrink: 0;
    &.day {
        color: rgb(30 41 59 / 30%);
    }
    &:hover {
        color: #f87171;
        background: rgb(239 68 68 / 12%);
    }
}
.mx_FanoosDashboard_adminFloatChipSpinner {
    width: 10px;
    height: 10px;
    border: 1.5px solid rgb(255 255 255 / 10%);
    border-top-color: #6366f1;
    border-radius: 50%;
    animation: fanoos_spin 0.7s linear infinite;
    flex-shrink: 0;
}
.mx_FanoosDashboard_adminFloatEmpty {
    font-size: 11px;
    color: rgb(255 255 255 / 25%);
    padding: 4px 2px;
    font-style: italic;
    &.day {
        color: rgb(30 41 59 / 30%);
    }
}
.mx_FanoosDashboard_adminFloatRoomAdd {
    position: relative;
}
.mx_FanoosDashboard_adminFloatRoomDropdown {
    /* Positioned via inline style (portaled to body with position:fixed) — no layout props here */
    background: #1a2035;
    border: 1px solid rgb(99 102 241 / 25%);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 40%);
    overflow: hidden;
    &.day {
        background: #ffffff;
        border-color: rgb(99 102 241 / 20%);
        box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
    }
}
.mx_FanoosDashboard_adminFloatRoomOption {
    display: flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgb(255 255 255 / 4%);
    padding: 7px 10px;
    font-size: 12px;
    color: #cbd5e1;
    cursor: pointer;
    text-align: start;
    transition: background 0.1s;
    &.day {
        color: #334155;
        border-bottom-color: rgb(0 0 0 / 5%);
    }
    &:last-child {
        border-bottom: none;
    }
    &:hover {
        background: rgb(99 102 241 / 12%);
        color: #a5b4fc;
    }
    &.day:hover {
        color: #4f46e5;
    }
    &:disabled {
        opacity: 0.4;
        pointer-events: none;
    }
}

/* ── Room chip action buttons ── */
.mx_FanoosDashboard_adminFloatRoomActions {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
    margin-inline-start: auto;
}
.mx_FanoosDashboard_adminFloatRoomBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 3px 4px;
    cursor: pointer;
    color: rgb(255 255 255 / 30%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
        background 0.1s,
        color 0.1s;
    &.day {
        color: rgb(30 41 59 / 30%);
    }
    &:hover {
        background: rgb(99 102 241 / 15%);
        color: #a5b4fc;
    }
    &.day:hover {
        color: #4f46e5;
    }
    &.active {
        color: #f59e0b;
    }
    &.active.day {
        color: #d97706;
    }
    &.danger:hover {
        background: rgb(239 68 68 / 15%);
        color: #f87171;
    }
    &.danger.day:hover {
        color: #dc2626;
    }
    &.busy {
        opacity: 0.5;
        pointer-events: none;
    }
    &:disabled {
        opacity: 0.4;
        pointer-events: none;
    }
}

/* ── Remove confirmation inline row ── */
.mx_FanoosDashboard_adminFloatRoomConfirm {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-inline-start: auto;
    flex-shrink: 0;
}
.mx_FanoosDashboard_adminFloatRoomConfirmBtn {
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    color: rgb(255 255 255 / 60%);
    cursor: pointer;
    &.day {
        background: rgb(0 0 0 / 5%);
        border-color: rgb(0 0 0 / 12%);
        color: rgb(30 41 59 / 65%);
    }
    &.yes {
        background: rgb(239 68 68 / 15%);
        border-color: rgb(239 68 68 / 30%);
        color: #f87171;
    }
    &.yes.day {
        color: #dc2626;
    }
    &:hover {
        border-color: rgb(99 102 241 / 40%);
    }
}
.mx_FanoosDashboard_adminFloatRoomChip.confirming {
    background: rgb(239 68 68 / 6%);
    border-color: rgb(239 68 68 / 15%);
}

/* ── User account actions section ── */
.mx_FanoosDashboard_adminFloatActionBtns {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}
.mx_FanoosDashboard_adminFloatActionBtn {
    display: flex;
    align-items: center;
    gap: 5px;
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    color: #cbd5e1;
    cursor: pointer;
    transition:
        background 0.12s,
        border-color 0.12s;
    &.day {
        background: rgb(0 0 0 / 5%);
        border-color: rgb(0 0 0 / 10%);
        color: #334155;
    }
    &:hover {
        background: rgb(99 102 241 / 12%);
        border-color: #6366f1;
        color: #a5b4fc;
    }
    &.day:hover {
        color: #4f46e5;
    }
    &.warn {
        color: #fb923c;
        border-color: rgb(251 146 60 / 25%);
        background: rgb(251 146 60 / 8%);
    }
    &.warn:hover {
        background: rgb(251 146 60 / 18%);
    }
    &.danger {
        color: #f87171;
        border-color: rgb(239 68 68 / 25%);
        background: rgb(239 68 68 / 8%);
    }
    &.danger:hover {
        background: rgb(239 68 68 / 18%);
    }
    &.danger.day {
        color: #dc2626;
    }
}
.mx_FanoosDashboard_adminFloatConfirmRow {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
    background: rgb(239 68 68 / 6%);
    border: 1px solid rgb(239 68 68 / 15%);
    border-radius: 8px;
    &.day {
        background: rgb(239 68 68 / 4%);
    }
}
.mx_FanoosDashboard_adminFloatConfirmMsg {
    font-size: 12px;
    color: #fca5a5;
    line-height: 1.4;
    &.day {
        color: #b91c1c;
    }
}
.mx_FanoosDashboard_adminFloatAvatarRow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 4px;
}
.mx_FanoosDashboard_adminFloatUserInfo {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}
.mx_FanoosDashboard_adminFloatUserDn {
    font-size: 15px;
    font-weight: 700;
    color: #e2e8f0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    &.day {
        color: #1e293b;
    }
}
.mx_FanoosDashboard_adminFloatUserId {
    font-size: 11px;
    color: rgb(255 255 255 / 35%);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    &.day {
        color: rgb(30 41 59 / 40%);
    }
}

/* ─── User Filter / Sort bar ─────────────────────────────────────────────── */
.mx_FanoosDashboard_adminFilterBar {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    flex-wrap: wrap;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    &.day {
        border-bottom-color: rgb(0 0 0 / 6%);
    }
}
.mx_FanoosDashboard_adminFilterSep {
    width: 1px;
    height: 16px;
    background: rgb(255 255 255 / 12%);
    flex-shrink: 0;
    &.day {
        background: rgb(0 0 0 / 12%);
    }
}
.mx_FanoosDashboard_adminFilterChip {
    background: transparent;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 20px;
    padding: 2px 10px;
    font-size: 11px;
    color: rgb(255 255 255 / 55%);
    cursor: pointer;
    transition: all 0.12s;
    &.day {
        border-color: rgb(0 0 0 / 14%);
        color: rgb(30 41 59 / 60%);
    }
    &:hover {
        border-color: #6366f1;
        color: #a5b4fc;
    }
    &.active {
        background: rgb(99 102 241 / 20%);
        border-color: #6366f1;
        color: #a5b4fc;
    }
    &.active.day {
        background: rgb(99 102 241 / 12%);
        color: #4f46e5;
    }
    &.danger.active {
        background: rgb(239 68 68 / 15%);
        border-color: #ef4444;
        color: #f87171;
    }
    &.danger.active.day {
        color: #dc2626;
    }
}
.mx_FanoosDashboard_adminSortSelect {
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    color: rgb(255 255 255 / 65%);
    cursor: pointer;
    margin-inline-start: auto;
    &.day {
        background: rgb(0 0 0 / 5%);
        border-color: rgb(0 0 0 / 12%);
        color: #334155;
    }
}
/* Last activity timestamp */
.mx_FanoosDashboard_adminUserActivity {
    font-size: 10px;
    color: rgb(255 255 255 / 30%);
    &.day {
        color: rgb(30 41 59 / 35%);
    }
}

/* ═══════════════════════════════════════════════════════════════════════════
   Space Outline — 3-level: Space → Group → Member
═══════════════════════════════════════════════════════════════════════════ */

/* ── Container ── */
.mx_FanoosDashboard_adminOutlineWrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    outline: none;
}
/* ── Toolbar ── */
.mx_FanoosDashboard_adminOutlineToolbar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 10px;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    flex-shrink: 0;
    &.day {
        border-bottom-color: rgb(0 0 0 / 6%);
    }
}
.mx_FanoosDashboard_adminOutlineToolSearch {
    flex: 1;
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 7px;
    padding: 4px 9px;
    font-size: 12px;
    color: #e2e8f0;
    outline: none;
    min-width: 0;
    &.day {
        background: rgb(255 255 255 / 85%);
        border-color: #b8c9dc;
        color: #1e293b;
    }
    &::placeholder {
        color: rgb(255 255 255 / 30%);
    }
    &.day::placeholder {
        color: rgb(30 41 59 / 35%);
    }
    &:focus {
        border-color: #6366f1;
    }
}
.mx_FanoosDashboard_adminOutlineToolDirBtn {
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 6px;
    padding: 3px 7px;
    font-size: 11px;
    color: rgb(255 255 255 / 55%);
    cursor: pointer;
    flex-shrink: 0;
    &.day {
        background: rgb(0 0 0 / 5%);
        border-color: rgb(0 0 0 / 10%);
        color: rgb(30 41 59 / 55%);
    }
    &:hover {
        background: rgb(99 102 241 / 15%);
        border-color: rgb(99 102 241 / 30%);
        color: #a5b4fc;
    }
}
.mx_FanoosDashboard_adminOutlineToolIconBtn {
    background: transparent;
    border: none;
    padding: 3px 6px;
    font-size: 14px;
    cursor: pointer;
    border-radius: 5px;
    color: rgb(255 255 255 / 45%);
    flex-shrink: 0;
    &.day {
        color: rgb(30 41 59 / 40%);
    }
    &:hover {
        background: rgb(99 102 241 / 12%);
        color: #a5b4fc;
    }
    &.add {
        color: #a5b4fc;
        font-size: 16px;
    }
    &.add:hover {
        background: rgb(99 102 241 / 20%);
    }
}

/* ── Body ── */
.mx_FanoosDashboard_adminOutlineBody {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 4px 0 20px;
}

/* ── Root row ("My Spaces") ── */
.mx_FanoosDashboard_adminOutlineRootRow {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 8px 5px 4px;
    cursor: pointer;
    user-select: none;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    &.day {
        border-bottom-color: rgb(0 0 0 / 7%);
    }
    &:hover {
        background: rgb(255 255 255 / 3%);
    }
    &.day:hover {
        background: rgb(0 0 0 / 2%);
    }
}
.mx_FanoosDashboard_adminOutlineRootLabel {
    flex: 1;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgb(255 255 255 / 35%);
    &.day {
        color: rgb(30 41 59 / 45%);
    }
}

/* ── Section (one per space + main) ── */
.mx_FanoosDashboard_adminOutlineSection {
    border-bottom: 1px solid rgb(255 255 255 / 4%);
    &.day {
        border-bottom-color: rgb(0 0 0 / 4%);
    }
    &.dragover {
        background: rgb(99 102 241 / 6%);
        outline: 2px dashed rgb(99 102 241 / 35%);
        outline-offset: -2px;
    }
}

/* ── Space row (level 0) ── */
.mx_FanoosDashboard_adminOutlineSpaceRow {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 3px 8px 3px 4px;
    cursor: pointer;
    transition: background 0.1s;
    min-width: 0;
    &:hover {
        background: rgb(99 102 241 / 7%);
    }
    &.selected {
        background: rgb(99 102 241 / 13%);
    }
    &.selected.day {
        background: rgb(99 102 241 / 9%);
    }
}

/* ── Group row (level 1) ── */
.mx_FanoosDashboard_adminOutlineGroupRow {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 2px 8px 2px 4px;
    cursor: pointer;
    transition: background 0.1s;
    min-width: 0;
    &:hover {
        background: rgb(99 102 241 / 7%);
    }
    &.selected {
        background: rgb(99 102 241 / 13%);
    }
    &.selected.day {
        background: rgb(99 102 241 / 9%);
    }
    &.dragging {
        opacity: 0.35;
    }
}

/* ── Name labels ── */
.mx_FanoosDashboard_adminOutlineSpaceName {
    flex: 1;
    font-size: 13px;
    font-weight: 600;
    color: #e2e8f0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    &.day {
        color: #1e293b;
    }
}
.mx_FanoosDashboard_adminOutlineGroupName {
    flex: 1;
    font-size: 12.5px;
    color: #cbd5e1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    &.day {
        color: #334155;
    }
}

/* ── Indentation containers ── */
.mx_FanoosDashboard_adminOutlineGroupIndent {
    padding-inline-start: 14px;
    border-inline-start: 1px solid rgb(255 255 255 / 5%);
    margin-inline-start: 12px;
    &.day {
        border-inline-start-color: rgb(0 0 0 / 6%);
    }
}
.mx_FanoosDashboard_adminOutlineMemberIndent {
    padding-inline-start: 14px;
    border-inline-start: 1px solid rgb(255 255 255 / 4%);
    margin-inline-start: 10px;
    &.day {
        border-inline-start-color: rgb(0 0 0 / 4%);
    }
}

/* ── Member row (level 2) ── */
.mx_FanoosDashboard_adminOutlineMemberRow {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    opacity: 0.75;
    &:hover {
        opacity: 1;
    }
}
.mx_FanoosDashboard_adminOutlineMemberAvatar {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: #fff;
    overflow: hidden;
    background: rgb(99 102 241 / 40%);
    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}
.mx_FanoosDashboard_adminOutlineMemberName {
    font-size: 12px;
    color: #94a3b8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    &.day {
        color: #475569;
    }
}
.mx_FanoosDashboard_adminOutlineMemberId {
    font-size: 10px;
    color: rgb(255 255 255 / 25%);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
    &.day {
        color: rgb(30 41 59 / 30%);
    }
}

/* ── Shared row pieces ── */
.mx_FanoosDashboard_adminOutlineGrip {
    color: rgb(255 255 255 / 20%);
    font-size: 10px;
    cursor: grab;
    flex-shrink: 0;
    user-select: none;
    &.day {
        color: rgb(30 41 59 / 20%);
    }
}
.mx_FanoosDashboard_adminOutlineExpander {
    background: transparent;
    border: none;
    color: rgb(255 255 255 / 45%);
    cursor: pointer;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    &.day {
        color: rgb(30 41 59 / 40%);
    }
    &:hover {
        background: rgb(255 255 255 / 6%);
    }
}
.mx_FanoosDashboard_adminOutlineNodeAvatar {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: #fff;
    overflow: hidden;
    background: rgb(99 102 241 / 55%);
    &.space {
        background: rgb(139 92 246 / 60%);
        border-radius: 7px;
        width: 20px;
        height: 20px;
    }
    &.main {
        background: rgb(99 102 241 / 30%);
    }
    &.group {
        background: rgb(34 197 94 / 40%);
    }
    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}
.mx_FanoosDashboard_adminOutlineBadge {
    background: rgb(255 255 255 / 9%);
    border-radius: 10px;
    padding: 1px 6px;
    font-size: 10px;
    color: rgb(255 255 255 / 45%);
    flex-shrink: 0;
    &.day {
        background: rgb(0 0 0 / 7%);
        color: rgb(30 41 59 / 50%);
    }
}
.mx_FanoosDashboard_adminOutlineSpinner {
    width: 13px;
    height: 13px;
    border: 2px solid rgb(255 255 255 / 12%);
    border-top-color: #6366f1;
    border-radius: 50%;
    animation: fanoos_spin 0.7s linear infinite;
    flex-shrink: 0;
}
.mx_FanoosDashboard_adminOutlineRowActions {
    display: flex;
    gap: 1px;
    opacity: 0;
    flex-shrink: 0;
    .mx_FanoosDashboard_adminOutlineSpaceRow:hover &,
    .mx_FanoosDashboard_adminOutlineGroupRow:hover & {
        opacity: 1;
    }
}
.mx_FanoosDashboard_adminOutlineActionBtn {
    background: transparent;
    border: none;
    padding: 2px 5px;
    cursor: pointer;
    border-radius: 4px;
    color: rgb(255 255 255 / 50%);
    display: flex;
    align-items: center;
    justify-content: center;
    &.day {
        color: rgb(30 41 59 / 45%);
    }
    &:hover {
        background: rgb(99 102 241 / 15%);
        color: #a5b4fc;
    }
    &.danger:hover {
        background: rgb(239 68 68 / 13%);
        color: #f87171;
    }
}

/* ── Inline add row ── */
.mx_FanoosDashboard_adminOutlineAddRow {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px 4px 28px;
}
.mx_FanoosDashboard_adminOutlineInlineInput {
    flex: 1;
    background: rgb(255 255 255 / 8%);
    border: 1px solid rgb(99 102 241 / 50%);
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 12px;
    color: #e2e8f0;
    outline: none;
    min-width: 0;
    &.day {
        background: #fff;
        border-color: #6366f1;
        color: #1e293b;
    }
}
.mx_FanoosDashboard_adminOutlineAddConfirm {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 13px;
    padding: 2px 6px;
    border-radius: 4px;
    color: #a5b4fc;
    &:hover {
        background: rgb(99 102 241 / 15%);
    }
    &:disabled {
        opacity: 0.4;
        cursor: default;
    }
}
.mx_FanoosDashboard_adminOutlineAddCancel {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 13px;
    padding: 2px 6px;
    border-radius: 4px;
    color: rgb(255 255 255 / 40%);
    &:hover {
        background: rgb(255 255 255 / 6%);
    }
}

/* ── Empty state label ── */
.mx_FanoosDashboard_adminOutlineEmptyLabel {
    padding: 8px 16px;
    font-size: 12px;
    color: rgb(255 255 255 / 30%);
    font-style: italic;
    &.day {
        color: rgb(30 41 59 / 35%);
    }
}

/* ── Float edit window (portaled to body) ── */
.mx_FanoosDashboard_adminOutlineFloat {
    position: fixed;
    width: 300px;
    background: #141926;
    border: 1px solid rgb(99 102 241 / 20%);
    border-radius: 12px;
    box-shadow: 0 16px 48px rgb(0 0 0 / 60%);
    display: flex;
    flex-direction: column;
    z-index: 9000;
    overflow: hidden;
    &.day {
        background: #f8fafc;
        border-color: rgb(99 102 241 / 20%);
        box-shadow: 0 12px 40px rgb(0 0 0 / 15%);
    }
}
.mx_FanoosDashboard_adminOutlineFloatHead {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    cursor: move;
    user-select: none;
    gap: 8px;
    &.day {
        border-bottom-color: rgb(0 0 0 / 7%);
    }
}
.mx_FanoosDashboard_adminOutlineFloatBody {
    overflow-y: auto;
    max-height: 540px;
    padding: 12px 0;
    display: flex;
    flex-direction: column;
}

/* ── Members list inside outline float ── */
.mx_FanoosDashboard_adminOutlineFloatMembers {
    display: flex;
    flex-direction: column;
    max-height: 160px;
    overflow-y: auto;
    margin: 4px 0;
}
.mx_FanoosDashboard_adminOutlineFloatMember {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 14px;
    transition: background 0.1s;
    &:hover {
        background: rgb(255 255 255 / 4%);
    }
    &.day:hover {
        background: rgb(0 0 0 / 3%);
    }
    &.confirming {
        background: rgb(239 68 68 / 6%);
    }
}
.mx_FanoosDashboard_adminOutlineFloatMemberAvatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    color: #fff;
    overflow: hidden;
    background: rgb(99 102 241 / 50%);
    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}
.mx_FanoosDashboard_adminOutlineFloatMemberName {
    flex: 1;
    font-size: 12.5px;
    color: #cbd5e1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    &.day {
        color: #334155;
    }
}
.mx_FanoosDashboard_adminOutlineFloatMemberConfirm {
    display: flex;
    align-items: center;
    gap: 4px;
}
.mx_FanoosDashboard_adminOutlineFloatMemberBtn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    color: rgb(255 255 255 / 40%);
    flex-shrink: 0;
    &:hover {
        background: rgb(239 68 68 / 12%);
        color: #f87171;
    }
    &.day {
        color: rgb(30 41 59 / 40%);
    }
}
.mx_FanoosDashboard_adminOutlineFloatPLSelect {
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 4px;
    padding: 1px 4px;
    font-size: 10px;
    color: rgb(255 255 255 / 50%);
    cursor: pointer;
    flex-shrink: 0;
    &.day {
        background: rgb(0 0 0 / 4%);
        border-color: rgb(0 0 0 / 10%);
        color: rgb(30 41 59 / 55%);
    }
    &:focus {
        outline: none;
        border-color: #6366f1;
    }
}

/* ── Spinner keyframe ── */
@keyframes fanoos_spin {
    to {
        transform: rotate(360deg);
    }
}

/* ═══════════════════════════════════════════════════════════════════════════
   Draw Tab
═══════════════════════════════════════════════════════════════════════════ */
.mx_FanoosDashboard_drawTab {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    background: #0d1117;
    &.day {
        background: #f5f5f5;
    }
}
.mx_FanoosDashboard_drawToolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-bottom: 1px solid rgb(255 255 255 / 7%);
    flex-shrink: 0;
    &.day {
        border-bottom-color: rgb(0 0 0 / 7%);
        background: #fff;
    }
}
.mx_FanoosDashboard_drawToolbarTitle {
    font-size: 13px;
    font-weight: 700;
    color: rgb(255 255 255 / 50%);
    flex: 1;
    &.day {
        color: rgb(30 41 59 / 50%);
    }
}
.mx_FanoosDashboard_drawSaveBtn {
    background: rgb(99 102 241 / 15%);
    border: 1px solid rgb(99 102 241 / 30%);
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
    color: #a5b4fc;
    cursor: pointer;
    transition:
        background 0.15s,
        color 0.15s;
    &:hover {
        background: rgb(99 102 241 / 28%);
    }
    &.saved {
        background: rgb(34 197 94 / 15%);
        border-color: rgb(34 197 94 / 30%);
        color: #4ade80;
    }
    &.saving {
        opacity: 0.6;
        cursor: wait;
    }
    &.day {
        color: #4f46e5;
    }
    &.day.saved {
        color: #16a34a;
    }
}
.mx_FanoosDashboard_drawCanvas {
    flex: 1;
    overflow: hidden;
    position: relative;
    /* Excalidraw needs explicit height — flex:1 alone is not enough */
    height: 0; /* forces flex child to be measurable */
    /* Excalidraw root div fills the container */
    > div {
        width: 100%;
        height: 100%;
    }
    .excalidraw {
        width: 100%;
        height: 100%;
    }

    /* ── Strip all external / social links from Excalidraw ────────────────
     *
     * 1. HelpDialog header: four <a> buttons (Docs, Blog, GitHub, YouTube).
     *    The keyboard-shortcut islands below it are in a separate element, so
     *    hiding only the header keeps all shortcuts visible.
     *
     * 2. Library publish dialog: note paragraphs that link to
     *    libraries.excalidraw.com and the GitHub guidelines page.
     *
     * MainMenu <Socials> is already omitted in JSX — no CSS needed there.
     * ──────────────────────────────────────────────────────────────────── */
    .excalidraw .HelpDialog__header {
        display: none !important;
    }
    .excalidraw .publish-library-note {
        display: none !important;
    }

    /* ── Collapsible properties panel ─────────────────────────────────── */
    .excalidraw .selected-shape-actions .Island .fanoos-collapse-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 20px;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: 0;
        color: var(--icon-fill-color, #888);
        opacity: 0.4;
        pointer-events: auto !important;
        transition: opacity 0.15s;
    }
    .excalidraw .selected-shape-actions .Island .fanoos-collapse-toggle:hover {
        opacity: 1;
    }
    .excalidraw .selected-shape-actions .Island .fanoos-collapse-toggle svg {
        width: 14px;
        height: 14px;
        transition: transform 0.2s;
    }
    .excalidraw .selected-shape-actions .Island.fanoos-panel-collapsed .fanoos-collapse-toggle svg {
        transform: rotate(180deg);
    }
    .excalidraw .selected-shape-actions .Island.fanoos-panel-collapsed > *:not(.fanoos-collapse-toggle) {
        display: none;
    }
}
/* Filename save dialog */
.mx_FanoosDashboard_drawDialog {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 50%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    &.day {
        background: rgb(0 0 0 / 25%);
    }
}
.mx_FanoosDashboard_drawDialogBox {
    background: #1e293b;
    border: 1px solid rgb(99 102 241 / 30%);
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 260px;
    box-shadow: 0 8px 32px rgb(0 0 0 / 50%);
    &.day {
        background: #f8fafc;
        border-color: rgb(79 70 229 / 25%);
    }
}
.mx_FanoosDashboard_drawDialogLabel {
    font-size: 12px;
    font-weight: 600;
    color: rgb(255 255 255 / 60%);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    &.day {
        color: rgb(15 23 42 / 55%);
    }
}
.mx_FanoosDashboard_drawDialogInput {
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    color: #e2e8f0;
    outline: none;
    &:focus {
        border-color: rgb(99 102 241 / 60%);
    }
    &.day {
        background: #fff;
        border-color: rgb(79 70 229 / 25%);
        color: #1e293b;
    }
    &.day:focus {
        border-color: #6366f1;
    }
}
.mx_FanoosDashboard_drawDialogActions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}
.mx_FanoosDashboard_drawDialogConfirm {
    background: rgb(99 102 241 / 20%);
    border: 1px solid rgb(99 102 241 / 40%);
    border-radius: 6px;
    padding: 5px 14px;
    font-size: 12px;
    color: #a5b4fc;
    cursor: pointer;
    &:hover {
        background: rgb(99 102 241 / 35%);
    }
    &.day {
        color: #4f46e5;
    }
}
.mx_FanoosDashboard_drawDialogCancel {
    background: transparent;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 6px;
    padding: 5px 14px;
    font-size: 12px;
    color: rgb(255 255 255 / 45%);
    cursor: pointer;
    &:hover {
        background: rgb(255 255 255 / 6%);
    }
    &.day {
        border-color: rgb(15 23 42 / 20%);
        color: rgb(15 23 42 / 50%);
    }
}
.mx_FanoosDashboard_drawLoading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-size: 14px;
    color: rgb(255 255 255 / 30%);
    &.day {
        color: rgb(30 41 59 / 35%);
    }
}

/* ── Fanoos: light-beige chat background (light theme only) ─────────────── */
.mx_MatrixChat:not(.cpd-theme-dark) {
    .mx_RoomView_messagePanel,
    .mx_RoomView_messagePanelSpinner,
    .mx_RoomView_messagePanelSearchSpinner {
        background-color: #faf7f2;
    }
}
