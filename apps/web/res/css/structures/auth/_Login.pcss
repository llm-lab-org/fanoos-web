/* ── Fanoos: server picker as an inline field ────────────────── */
.mx_ServerPicker.mx_ServerPicker_field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border: 1px solid $input-border-color;
    border-radius: 8px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    background: $background;

    &:hover {
        border-color: $accent;
        box-shadow: 0 0 0 2px rgba(0, 122, 204, 0.12);
    }

    h2 { display: none; }

    .mx_ServerPicker_fieldIcon {
        color: $secondary-content;
        flex-shrink: 0;
        display: flex;
        align-items: center;
    }

    .mx_ServerPicker_fieldContent {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 1px;
        min-width: 0;
    }

    .mx_ServerPicker_fieldLabel {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: $secondary-content;
        line-height: 1.2;
    }

    .mx_ServerPicker_server {
        font-size: 14px;
        color: $primary-content;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mx_ServerPicker_fieldEdit {
        color: $secondary-content;
        flex-shrink: 0;
        opacity: 0.6;
    }
}

/* hide the login-type switcher (email/phone/username toggle) */
.mx_Login_type_container { display: none; }

.mx_Login_submit {
    width: 100%;
    margin-top: 24px;
    margin-bottom: 24px;
}

.mx_Login_loader {
    display: inline;
    position: relative;
    top: 2px;
    left: 8px;
}

.mx_Login_loader .mx_Spinner {
    display: inline;
}

.mx_Login_loader .mx_Spinner img {
    width: 16px;
    height: 16px;
}

.mx_Login_error {
    color: $alert;
    font-weight: bold;
    text-align: center;
    margin-top: 12px;
    margin-bottom: 12px;
}

.mx_Login_error.mx_Login_serverError {
    text-align: left;
    font-weight: normal;
}

.mx_Login_error.mx_Login_serverError.mx_Login_serverErrorNonFatal {
    color: #ff8d13; /* Only used here */
}

.mx_Login_type_container {
    display: flex;
    align-items: center;
    color: $authpage-primary-color;

    .mx_Field {
        margin: 0;
    }
}

.mx_Login_type_label {
    flex: 1;
}

.mx_Login_underlinedServerName {
    width: max-content;
    border-bottom: 1px dashed $accent;
}

div.mx_AccessibleButton_kind_link.mx_Login_forgot {
    display: block;
    margin-top: 24px;

    &.mx_AccessibleButton_disabled {
        cursor: not-allowed;
    }
}

.mx_Login_spinner {
    display: flex;
    justify-content: center;
    align-items: center;
    align-content: center;
    padding: 14px;
}

.mx_Login_fullWidthButton {
    width: 100%;
    margin-bottom: 16px;
}
