.mx_MFileBody_download {
    color: $accent;
    height: var(--cpd-space-9x);
}

.mx_MFileBody_download object {
    margin-left: -16px;
    padding-right: 4px;
    margin-top: -4px;
    vertical-align: middle;
    pointer-events: none;
}

/* Remove the border and padding for iframes for download links. */
.mx_MFileBody_download iframe {
    margin: 0px;
    padding: 0px;
    border: none;
    width: 100%;
}

/* ── Compact style: audio/video used in reply tiles ── */
.mx_MFileBody_info {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);

    .mx_MFileBody_info_icon {
        background-color: $system;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 16px;
        height: 16px;
        padding: var(--cpd-space-2x);

        svg {
            color: $secondary-content;
            width: inherit;
            height: inherit;
        }
    }

    .mx_MFileBody_info_filename {
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-primary);
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
        flex: 1;
        min-width: 0;
    }
}

/* ── Telegram-style file bubble ── */
.mx_MFileBody_tg {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-radius: 14px;
    background: var(--cpd-color-bg-canvas-default, $header-panel-bg-color);
    cursor: pointer;
    min-width: 220px;
    max-width: 320px;
    box-sizing: border-box;
    border: none;
    vertical-align: top;
    text-align: start;
    text-decoration: none;
    color: inherit;
    transition:
        background 0.12s ease,
        transform 0.12s ease;
    /* ensure both circles stay inside the card */
    overflow: hidden;

    &:hover,
    &:focus-visible {
        background: var(--cpd-color-bg-subtle-primary, $header-panel-bg-hover);
        outline: none;

        .mx_MFileBody_tg_dl {
            background: $accent;
            color: #fff;
            transform: scale(1.06);
        }
    }

    &:active {
        transform: translateY(1px);
    }
}

.mx_MFileBody_tg_icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* keep the circle flush with inner padding */
    margin: 1px 0;
}

.mx_MFileBody_tg_info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
    padding-inline-end: 2px;
    direction: ltr;
    unicode-bidi: embed;
}

.mx_MFileBody_tg_name {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--cpd-color-text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: block;
    margin-bottom: 2px;
}

.mx_MFileBody_tg_meta {
    font-size: 11px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--cpd-color-text-secondary);
    white-space: nowrap;
    display: block;
}

.mx_MFileBody_tg_dl {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    padding: 0;
    background: $accent;
    color: #fff;
    box-shadow: 0 1px 2px rgb(0, 0, 0, 0.12);
    transition:
        background 0.12s ease,
        color 0.12s ease,
        transform 0.12s ease;
    margin: 0;
    pointer-events: none;

    svg {
        display: block;
    }
}
