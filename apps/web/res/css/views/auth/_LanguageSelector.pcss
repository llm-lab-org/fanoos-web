.mx_LanguageSelector_buttons {
    display: flex;
    gap: 6px;
    justify-content: center;
    width: 100%;
}

.mx_LanguageSelector_btn {
    flex: 1;
    padding: 6px 4px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #1a2540;
    color: #c8d4f0;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;

    &:hover:not(:disabled) {
        background: #243058;
        color: #ffffff;
    }

    &:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
}

.mx_LanguageSelector_btn_active {
    background: #c8d4f0;
    border-color: transparent;
    color: #1a2540;
    font-weight: 600;
}
