.mx_LanguageSelector_buttons {
    display: flex;
    gap: 6px;
    justify-content: center;
    width: 100%;
}

.mx_LanguageSelector_btn {
    flex: 1;
    padding: 6px 4px;
    border-radius: 16px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: rgba(255, 255, 255, 0.45);
    color: #555e6e;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;

    &:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.75);
        border-color: rgba(0, 0, 0, 0.2);
        color: #1a1d23;
    }

    &:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
}

.mx_LanguageSelector_btn_active {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(0, 0, 0, 0.2);
    color: #1a1d23;
    font-weight: 600;
}
