.mx_AuthPage {
    width: 100%;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    background-color: $authpage-bg-color;
    height: 100vh;
    overflow: auto;
}

.mx_AuthPage_modal {
    display: flex;
    margin: 80px auto auto;
    border-radius: 20px;
    background-color: $authpage-modal-bg-color;
    overflow: hidden;

    @media only screen and (max-height: 768px) {
        margin-top: 40px;
    }

    @media only screen and (max-width: 480px) {
        margin-top: 0;
        border-radius: 0;
    }

    &.mx_AuthPage_modal_withBlur {
        box-shadow:
            0 32px 80px rgba(0, 0, 0, 0.45),
            0 8px 24px rgba(0, 0, 0, 0.3),
            0 0 0 1px rgba(255, 255, 255, 0.08);

        .mx_AuthPage_modalContent {
            background-color: rgba(255, 255, 255, 0.92);
        }
    }
}

/* ── Auth header: logo centred, bigger ───────────────────────── */
.mx_AuthHeaderLogo {
    display: flex;
    justify-content: center;
    padding: 32px 0 8px;

    img {
        height: 96px;
        width: auto;
        object-fit: contain;
    }
}

/* ── Auth body: generous padding ─────────────────────────────── */
.mx_AuthBody {
    padding: 0 40px 32px;
    min-width: 360px;
    max-width: 420px;

    h2 {
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 24px;
        text-align: center;
        color: $primary-content;
    }

    @media only screen and (max-width: 480px) {
        padding: 0 24px 24px;
        min-width: unset;
    }
}
