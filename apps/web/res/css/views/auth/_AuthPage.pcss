.mx_AuthPage {
    width: 100%;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    background-color: $authpage-bg-color;
    height: 100vh;
    overflow: auto;
}

.mx_AuthPage_modal {
    display: flex;
    margin: 340px auto auto;
    border-radius: 20px;
    background-color: $authpage-modal-bg-color;
    overflow: hidden;

    @media only screen and (max-height: 768px) {
        margin-top: 200px;
    }

    @media only screen and (max-width: 480px) {
        margin-top: 0;
        border-radius: 0;
    }

    &.mx_AuthPage_modal_withBlur {
        box-shadow:
            0 32px 80px rgba(0, 0, 0, 0.45),
            0 8px 24px rgba(0, 0, 0, 0.3),
            0 0 0 1px rgba(255, 255, 255, 0.08);

        .mx_AuthPage_modalContent {
            background-color: rgba(255, 255, 255, 0.92);
        }
    }
}

/* Modal content is flex row — AuthBody (order:1) left, AuthHeader (order:2) right */
.mx_AuthPage_modalContent {
    display: flex;
    flex-direction: row;
    border-radius: 20px;
    overflow: hidden;
}
