.mx_Field.mx_AppearanceUserSettingsTab_checkboxControlledField {
    width: 256px;
    /* Line up with Settings field toggle button */
    margin-inline-start: 0;
}

/* Fanoos appearance controls */
.mx_FanoosAppearance_row {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    margin-block: var(--cpd-space-2x);
    flex-wrap: wrap;
}

.mx_FanoosAppearance_label {
    flex: 1;
    min-width: 140px;
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-primary);
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
}

.mx_FanoosAppearance_value {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
    min-width: 40px;
}

.mx_FanoosAppearance_slider {
    flex: 2;
    min-width: 120px;
    accent-color: var(--cpd-color-icon-accent-tertiary);
}

.mx_FanoosAppearance_colorPicker {
    width: 40px;
    height: 32px;
    border: none;
    border-radius: 6px;
    padding: 2px;
    cursor: pointer;
    background: none;
}

.mx_FanoosAppearance_resetAll {
    margin-top: var(--cpd-space-4x);
}

.mx_FanoosAppearance_previewSwatch {
    display: inline-block;
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid var(--cpd-color-border-interactive-primary);
    flex-shrink: 0;
}

/* Palette grid */
.mx_FanoosAppearance_paletteGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
    gap: var(--cpd-space-3x);
    margin-top: var(--cpd-space-2x);
}

.mx_FanoosAppearance_paletteCard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--cpd-space-1x);
    padding: var(--cpd-space-2x);
    border-radius: 10px;
    border: 2px solid transparent;
    background: var(--cpd-color-bg-subtle-secondary);
    cursor: pointer;
    transition: border-color 0.15s, transform 0.1s;

    &:hover {
        border-color: var(--cpd-color-border-interactive-primary);
        transform: translateY(-1px);
    }

    &.mx_FanoosAppearance_paletteCard_active {
        border-color: var(--cpd-color-icon-accent-tertiary);
        box-shadow: 0 0 0 2px var(--cpd-color-icon-accent-tertiary);
    }
}

.mx_FanoosAppearance_palettePreview {
    width: 72px;
    height: 44px;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    border: 1px solid var(--cpd-color-border-interactive-primary);
}

.mx_FanoosAppearance_previewPanel {
    width: 22px;
    height: 100%;
    flex-shrink: 0;
}

.mx_FanoosAppearance_previewChat {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 4px;
    gap: 3px;
}

.mx_FanoosAppearance_previewBubbleSent {
    height: 8px;
    border-radius: 4px 4px 1px 4px;
    align-self: flex-end;
    width: 60%;
}

.mx_FanoosAppearance_previewBubbleReceived {
    height: 8px;
    border-radius: 4px 4px 4px 1px;
    align-self: flex-start;
    width: 70%;
}

.mx_FanoosAppearance_paletteLabel {
    font-size: $font-11px;
    color: var(--cpd-color-text-secondary);
    text-align: center;
    line-height: 1.2;
    word-break: break-word;
}
